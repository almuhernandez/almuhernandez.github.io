---
import BaseLayout from '../layouts/BaseLayout.astro';
import { students } from '../content/students';
---

<BaseLayout title="Estudiantes">
  <section class="student-hero page-hero" aria-labelledby="students-title">
    <div class="hero-grid">
      <div class="student-heading">
        <h1 id="students-title">{students.title}</h1>
        <p class="student-kicker">{students.highlightedIntroduction}</p>
      </div>
      <div class="hero-copy">
        <p class="lead">{students.introduction}</p>
        <p>{students.context}</p>
      </div>
    </div>
  </section>

  <section class="candidata-entry" aria-labelledby="candidata-title">
    <p class="entry-label">Proyecto educativo</p>
    <div>
      <h2 id="candidata-title">{students.candidata.title}</h2>
      <p>{students.candidata.description}</p>
      <a
        class="text-link text-link--accent"
        href={students.candidata.link.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {students.candidata.link.label}
      </a>
    </div>
  </section>

  <section class="student-resources" aria-labelledby="resources-title">
    <header class="section-heading">
      <h2 id="resources-title">{students.resourcesTitle}</h2>
    </header>
    <div class="resource-list">
      {students.resources.map((resource, index) => (
        <article>
          <p class="resource-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </p>
          <div>
            <p class="resource-type">{resource.type}</p>
            <h3>{resource.title}</h3>
          </div>
          <div class="resource-description">
            <p>{resource.description}</p>
            {resource.status === 'available' && resource.url ? (
              <a class="text-link" href={resource.url}>Acceder</a>
            ) : null}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="course-students" aria-labelledby="course-students-title">
    <h2 id="course-students-title">{students.courseStudents.title}</h2>
    <p>{students.courseStudents.description}</p>
  </section>
</BaseLayout>

<style>
  .student-hero .hero-grid {
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .student-hero .hero-copy {
    max-width: 44rem;
    margin-top: 0;
    padding-bottom: 0;
  }

  .student-kicker {
    display: block;
    max-width: 28rem;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: clamp(0.75rem, 1.5vw, 1.1rem);
    background: var(--color-accent);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 2.2rem);
    line-height: 1.25;
  }

  .student-hero .hero-copy > p:not(.lead) {
    color: var(--color-muted);
  }

  .candidata-entry {
    display: grid;
    grid-template-columns: minmax(10rem, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding: clamp(2.5rem, 7vw, 6rem);
    border-top: 0.65rem solid var(--color-accent);
    color: var(--color-paper);
    background: var(--color-highlight-dark);
  }

  .entry-label,
  .resource-type,
  .resource-status {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .candidata-entry h2,
  .course-students h2 {
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .candidata-entry > div {
    max-width: 42rem;
  }

  .candidata-entry > div > p {
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
  }

  .candidata-entry .text-link {
    margin-top: 1.5rem;
    color: var(--color-ink);
  }

  .candidata-entry .text-link:is(:hover, :active) {
    color: var(--color-aubergine);
    background: var(--color-surface);
  }

  .candidata-entry .text-link:focus-visible {
    outline-color: var(--color-accent);
  }

  .student-resources {
    margin-top: clamp(6rem, 12vw, 11rem);
  }

  .student-resources .section-heading {
    grid-template-columns: 1fr;
  }

  .resource-list article {
    display: grid;
    grid-template-columns: minmax(2rem, 0.3fr) minmax(12rem, 0.9fr) 1.2fr;
    gap: 2rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .resource-number {
    display: grid;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0;
    place-items: center;
    background: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .resource-type {
    margin-bottom: 0.45rem;
    color: var(--color-muted);
  }

  .resource-list h3 {
    margin-bottom: 0;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
  }

  .resource-description > p {
    color: var(--color-muted);
  }

  .resource-status {
    display: inline-block;
    padding-bottom: 0.2rem;
    border-bottom: 0.25rem solid var(--color-accent);
    color: var(--color-muted);
  }

  .course-students {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 8vw, 8rem);
    margin-top: clamp(6rem, 12vw, 11rem);
    padding: clamp(2.5rem, 6vw, 5rem);
    background: var(--color-soft);
  }

  .course-students h2 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }

  .course-students p {
    align-self: end;
    font-size: 1.05rem;
  }

  @media (max-width: 50rem) {
    .student-hero .hero-grid {
      grid-template-columns: 1fr;
      gap: clamp(1.75rem, 5vw, 2.5rem);
    }

    .student-kicker {
      margin-top: 1.5rem;
    }

    .candidata-entry,
    .course-students {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .resource-list article {
      grid-template-columns: 2rem 1fr;
      gap: 1rem;
    }

    .resource-description {
      grid-column: 2;
    }
  }
</style>
