---
import BaseLayout from '../layouts/BaseLayout.astro';
import { caseStudies, projectsPage } from '../content/projects';
---

<BaseLayout title="Proyectos">
  <section class="hero page-hero projects-hero" aria-labelledby="projects-title">
    <div class="hero-grid">
      <h1 id="projects-title">{projectsPage.title}</h1>
      <div class="hero-copy">
        {projectsPage.introduction.map((paragraph, index) => (
          <p class={index === 0 ? 'lead' : undefined}>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="project-block case-studies" aria-labelledby="case-studies-title">
    <header class="block-heading">
      <p aria-hidden="true">{projectsPage.caseStudySection.number}</p>
      <h2 id="case-studies-title">{projectsPage.caseStudySection.title}</h2>
    </header>
    <div class="block-content">
      <div class="block-introduction">
        {projectsPage.caseStudySection.introduction.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <div class="block-content case-study-content">
      <div class="case-study-list">
        {caseStudies.map((project) => (
          <article class="case-study">
            <div class="case-study-meta">
              <span class="status">{project.status}</span>
            </div>
            <p class="project-category">{project.category}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="project-block experience-projects" aria-labelledby="project-experience-title">
    <header class="block-heading">
      <p aria-hidden="true">{projectsPage.experienceSection.number}</p>
      <h2 id="project-experience-title">
        {projectsPage.experienceSection.title}
      </h2>
    </header>
    <div class="block-content">
      {projectsPage.experienceSection.introduction.length > 0 && (
        <div class="block-introduction">
          {projectsPage.experienceSection.introduction.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
      <div class="project-areas">
        {projectsPage.experienceSection.areas.map((area, index) => (
          <article>
            <p class="area-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3>{area.title}</h3>
            <ul>
              {area.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <p class="confidentiality-note">
        {projectsPage.experienceSection.confidentialityNote}
      </p>
    </div>
  </section>

  <section class="project-block own-projects" aria-labelledby="own-projects-title">
    <header class="block-heading">
      <p aria-hidden="true">{projectsPage.ownProjectsSection.number}</p>
      <h2 id="own-projects-title">{projectsPage.ownProjectsSection.title}</h2>
    </header>
    <div class="block-content">
      {projectsPage.ownProjectsSection.projects.map((project) => (
        <article class="own-project">
          <div class="own-project-copy">
            <h3>{project.title}</h3>
            {project.description.map((paragraph) => <p>{paragraph}</p>)}
            <a
              class="text-link text-link--accent"
              href={project.link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.link.label}
            </a>
          </div>
          <div class="ecosystem">
            <p class="content-label">{project.ecosystemTitle}</p>
            <ul>
              {project.ecosystem.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="projects-cross-link">
    <a class="text-link" href="/experiencia/">Ver experiencia</a>
  </div>
</BaseLayout>

<style>
  .project-block {
    display: grid;
    grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.45fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4rem, 9vw, 8rem);
    border-top: 1px solid var(--color-ink);
  }

  .project-block:last-of-type {
    border-bottom: 1px solid var(--color-ink);
  }

  .case-studies {
    row-gap: clamp(2rem, 4vw, 3rem);
  }

  .block-heading {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-content: start;
  }

  .block-heading > p,
  .content-label,
  .project-category {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .block-heading > p {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    background: var(--color-accent);
  }

  .block-heading h2 {
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .block-content {
    min-width: 0;
  }

  .block-introduction {
    max-width: 46rem;
    font-size: 1.05rem;
  }

  .case-study-content {
    grid-column: 2;
  }

  .case-study {
    margin-top: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
    border-top: 0.6rem solid var(--color-accent);
    background: var(--color-soft);
  }

  .case-study-meta {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    align-items: center;
  }

  .status {
    padding: 0.35rem 0.6rem;
    background: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-category {
    margin-top: 3.5rem;
  }

  .case-study h3,
  .own-project h3 {
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.7rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .ecosystem ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ecosystem li {
    padding-bottom: 0.2rem;
    border-bottom: 0.2rem solid var(--color-accent);
    font-weight: 700;
  }

  .project-areas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 3rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .project-areas article {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem 1.25rem;
    align-content: start;
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .project-areas article:nth-child(even) {
    border-left: 1px solid var(--color-line);
  }

  .project-areas article:nth-child(n + 3) {
    border-top: 1px solid var(--color-line);
  }

  .project-areas article > .area-number {
    background: transparent;
    border-bottom: 0.35rem solid var(--color-accent);
  }

  .project-areas h3 {
    margin-bottom: 0;
    font-size: 1.1rem;
  }

  .project-areas ul {
    grid-column: 2;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
  }

  .confidentiality-note {
    margin-top: 2rem;
    padding-left: 1.25rem;
    border-left: 0.35rem solid var(--color-accent);
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .own-projects {
    color: var(--color-paper);
    background: var(--color-ink);
    box-shadow: 50vw 0 0 var(--color-ink), -50vw 0 0 var(--color-ink);
  }

  .own-projects .block-heading > p {
    color: var(--color-ink);
  }

  .own-project {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(3rem, 8vw, 7rem);
    margin-top: 0;
  }

  .own-project-copy .text-link {
    margin-top: 2rem;
    color: var(--color-ink);
  }

  .own-project-copy .text-link--accent:is(:hover, :active) {
    color: var(--color-aubergine);
    background: var(--color-surface);
    text-decoration: none;
  }

  .own-project-copy .text-link--accent:focus-visible {
    outline-color: var(--color-surface);
  }

  .ecosystem {
    align-self: end;
    padding-top: 1.5rem;
    border-top: 1px solid #555;
  }

  .ecosystem ul {
    display: flex;
    gap: 0.5rem 1rem;
  }

  .ecosystem li {
    border-color: var(--color-accent);
  }

  .projects-cross-link {
    display: flex;
    justify-content: flex-end;
    padding-top: 3rem;
  }

  @media (max-width: 50rem) {
    .project-block,
    .own-project {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .case-study-content {
      grid-column: 1;
    }

    .project-areas {
      grid-template-columns: 1fr;
    }

    .project-areas article:nth-child(even) {
      border-left: 0;
    }

    .project-areas article + article {
      border-top: 1px solid var(--color-line);
    }

    .projects-cross-link {
      justify-content: flex-start;
    }
  }

</style>
