---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teachingPage } from '../content/teaching';
---

<BaseLayout title="Docencia">
  <section class="hero page-hero teaching-hero" aria-labelledby="teaching-title">
    <div class="hero-grid">
      <h1 id="teaching-title">{teachingPage.title}</h1>
      <div class="hero-copy">
        {teachingPage.introduction.map((paragraph, index) => (
          <p class={index === 0 ? 'lead' : undefined}>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <figure class="teaching-visual">
    <img
      src="/images/teaching.jpeg"
      alt="Almu Hernández trabajando con un ordenador portátil"
      width="2400"
      height="1600"
    />
  </figure>

  <div class="teaching-areas">
    {teachingPage.areas.map((area) => (
      <article class="teaching-area">
        <header class="area-heading">
          <p aria-hidden="true">{area.number}</p>
          <h2>{area.title}</h2>
        </header>

        <div class="area-content">
          {'organizations' in area && (
            <div class="organizations">
              {area.organizations.map((organization) => (
                <section>
                  <p class="content-label">{organization.name}</p>
                  <h3>{organization.role}</h3>
                  {organization.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                </section>
              ))}
            </div>
          )}

          {'paragraphs' in area && (
            <div class="area-copy">
              {area.paragraphs.map((paragraph, index) => (
                <p class={index === 0 ? 'area-lead' : undefined}>{paragraph}</p>
              ))}
            </div>
          )}

          {'tools' in area && (
            <div class="tools">
              <p class="content-label">{area.tools.label}</p>
              <ul>
                {area.tools.items.map((tool) => <li>{tool}</li>)}
              </ul>
            </div>
          )}

          {'project' in area && (
            <div class="educational-project">
              <p class="content-label">Proyecto educativo propio</p>
              <h3>{area.project.name}</h3>
              <p>{area.project.description}</p>
              <a
                class="text-link candidata-link"
                href={area.project.link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {area.project.link.label}
              </a>
            </div>
          )}

          {'experience' in area && (
            <section class="mentoring-experience">
              <div>
                <p class="content-label">{area.experience.name}</p>
                <h3>{area.experience.role}</h3>
              </div>
              <div>
                <p class="content-label">{area.experience.date}</p>
                <p>{area.experience.description}</p>
              </div>
            </section>
          )}

          {'topics' in area && (
            <div class="topics">
              {area.topics.map((topic) => (
                <section>
                  <h3>{topic.title}</h3>
                  <p>{topic.description}</p>
                </section>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

  <section class="approach" aria-labelledby="approach-title">
    <h2 id="approach-title">{teachingPage.approach.title}</h2>
    <div>
      {teachingPage.approach.paragraphs.map((paragraph, index) => (
        <p class={index === 0 ? 'approach-lead' : undefined}>{paragraph}</p>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .teaching-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    margin: 0 0 clamp(5rem, 10vw, 9rem) auto;
  }

  .teaching-visual::before {
    position: absolute;
    inset: auto auto -1rem 0;
    width: 32%;
    height: 44%;
    z-index: -1;
    background: var(--color-accent);
    content: "";
  }

  .teaching-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .teaching-areas {
    border-top: 1px solid var(--color-ink);
  }

  .teaching-area {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    border-bottom: 1px solid var(--color-ink);
  }

  .area-heading {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-content: start;
  }

  .area-heading > p,
  .content-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .area-heading > p {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    background: var(--color-accent);
  }

  .area-heading h2,
  .approach h2 {
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .area-content {
    max-width: 45rem;
  }

  .area-copy,
  .organizations,
  .topics {
    font-size: 1.05rem;
  }

  .area-lead {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    line-height: 1.3;
  }

  .organizations,
  .topics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
  }

  .organizations h3,
  .topics h3,
  .educational-project h3 {
    font-size: 1.25rem;
  }

  .tools,
  .educational-project,
  .mentoring-experience {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .tools ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tools li {
    padding: 0.35rem 0.65rem;
    border-bottom: 0.25rem solid var(--color-accent);
    font-weight: 700;
  }

  .educational-project {
    padding-left: 1.5rem;
    border-top: 0;
    border-left: 0.4rem solid var(--color-accent);
  }

  .candidata-link {
    margin-top: 0.75rem;
  }

  .candidata-link::after {
    content: none;
  }

  .pending-link {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mentoring-experience {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2rem;
  }

  .mentoring-experience h3,
  .mentoring-experience p {
    margin-bottom: 0;
  }

  .approach {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 8vw, 8rem);
    margin-top: clamp(6rem, 12vw, 11rem);
    padding: clamp(2.5rem, 6vw, 5rem);
    color: var(--color-paper);
    background: var(--color-highlight-dark);
  }

  .approach-lead {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.25;
  }

  @media (max-width: 50rem) {
    .teaching-visual {
      width: 100%;
      margin-right: 0;
    }

    .teaching-visual img {
      object-position: center;
    }

    .teaching-area,
    .approach {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .organizations,
    .topics,
    .mentoring-experience {
      grid-template-columns: 1fr;
    }
  }
</style>
