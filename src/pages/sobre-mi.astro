---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../content/about';
---

<BaseLayout title="Sobre Mí">
  <section class="about-page" aria-labelledby="about-title">
    <header class="about-heading">
      <h1 id="about-title">{about.title}</h1>
    </header>
    <div class="about-layout">
      <figure class="about-portrait">
        <img
          src="/images/about.jpeg"
          alt="Almu Hernández sonriendo con una taza"
          width="1800"
          height="1200"
        />
      </figure>
      <div class="about-copy">
        {about.paragraphs.map((paragraph, index) => (
          <p class={index === 0 ? 'lead' : undefined}>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="about-journey" aria-labelledby="journey-title">
    <header class="section-heading">
      <h2 id="journey-title">{about.journey.title}</h2>
    </header>
    <ol>
      {about.journey.stages.map((stage) => (
        <li>
          <p class="journey-number" aria-hidden="true">{stage.number}</p>
          <p class="journey-period">{stage.period}</p>
          <h3>{stage.title}</h3>
          <div class="journey-details">
            <p>{stage.detailLabel}</p>
            <p>{stage.details}</p>
          </div>
          <p class="journey-copy">{stage.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="education" aria-labelledby="education-title">
    <header class="section-heading">
      <h2 id="education-title">{about.education.title}</h2>
    </header>
    <div class="education-columns">
      <section aria-labelledby="academic-title">
        <h3 id="academic-title">{about.education.academicTitle}</h3>
        <ul>
          {about.education.academic.map((item) => (
            <li>
              <p class="education-name">{item.name}</p>
              <p>{item.institution}</p>
              <p class="education-year">{item.year}</p>
            </li>
          ))}
        </ul>
      </section>
      <section aria-labelledby="certifications-title">
        <h3 id="certifications-title">{about.education.certificationsTitle}</h3>
        <ul>
          {about.education.certifications.map((item) => (
            <li>
              <p class="education-name">{item.name}</p>
              <p>{item.institution}</p>
              <p class="education-year">{item.year}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>

  <section class="about-closing" aria-labelledby="about-closing-title">
    <h2 id="about-closing-title">{about.closing.title}</h2>
    <div class="closing-actions">
      {about.closing.links.map((link, index) => (
        <a
          class:list={['text-link', { 'text-link--accent': index === 0 }]}
          href={link.href}
          download={'download' in link ? true : undefined}
        >
          {link.label}
          {'note' in link && <span>{link.note}</span>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding: clamp(1rem, 4vw, 3rem) 0 clamp(3rem, 7vw, 6rem);
  }

  .about-heading {
    padding-top: 1rem;
    margin-bottom: clamp(2rem, 3vw, 3rem);
  }

  .about-heading h1 {
    max-width: none;
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .about-portrait {
    position: sticky;
    top: 2rem;
    aspect-ratio: 1 / 1;
    margin: clamp(2rem, 4vw, 3.5rem) 0 0 clamp(0rem, 3vw, 3rem);
  }

  .about-portrait::after {
    display: block;
    width: 42%;
    height: 0.55rem;
    margin-top: 1rem;
    background: var(--color-accent);
    content: "";
  }

  .about-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 56% center;
  }

  .about-copy {
    max-width: 43rem;
    padding-top: clamp(0rem, 2vw, 1.5rem);
  }

  .about-copy .lead {
    margin-bottom: 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.5vw, 2.25rem);
    line-height: 1.3;
  }

  .about-copy p:not(.lead) {
    color: var(--color-muted);
  }

  .about-copy p + p {
    margin-top: 1.5rem;
  }

  .about-journey,
  .education {
    padding-block: clamp(4rem, 9vw, 8rem);
    border-top: 1px solid var(--color-ink);
  }

  .about-journey .section-heading,
  .education .section-heading {
    grid-template-columns: 1fr;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    border-top: 0;
    border-bottom: 0;
  }

  .about-journey ol,
  .education ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-journey li {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(2rem, 4vw, 3rem);
  }

  .about-journey ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
  }

  .about-journey li:nth-child(even) {
    border-left: 1px solid var(--color-line);
  }

  .about-journey li:nth-child(n + 3) {
    border-top: 1px solid var(--color-line);
  }

  .journey-number,
  .journey-period {
    margin-bottom: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .journey-number {
    display: grid;
    width: 2rem;
    height: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    place-items: center;
    background: var(--color-accent);
  }

  .about-journey h3 {
    margin: 0.65rem 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .journey-details {
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .journey-details p:first-child {
    margin-bottom: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .journey-details p:last-child {
    margin-bottom: 0;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.45;
  }

  .journey-copy {
    margin: 2rem 0 0;
    color: var(--color-muted);
    font-size: 1.02rem;
  }

  .education-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 8vw, 8rem);
  }

  .education-columns > section {
    border-top: 0.45rem solid var(--color-accent);
  }

  .education-columns h3 {
    margin: 0;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-ink);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .education li {
    position: relative;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-line);
  }

  .education li:last-child {
    border-bottom: 0;
  }

  .education li p {
    margin-bottom: 0;
  }

  .education-name {
    padding-right: 4rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .education li p:not(.education-name, .education-year) {
    color: var(--color-muted);
  }

  .education-year {
    position: absolute;
    top: 1.75rem;
    right: 0;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .about-closing {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) auto;
    gap: 3rem;
    align-items: end;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding: clamp(2.5rem, 6vw, 5rem);
    border-top: 1px solid var(--color-ink);
    color: var(--color-paper);
    background: var(--color-highlight-dark);
  }

  .about-closing h2 {
    max-width: 16ch;
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: flex-end;
  }

  .closing-actions .text-link--accent {
    color: var(--color-ink);
  }

  .about-closing .text-link--accent:is(:hover, :active) {
    color: var(--color-aubergine);
    background: var(--color-surface);
  }

  .about-closing .text-link:focus-visible {
    outline-color: var(--color-accent);
  }

  .closing-actions span {
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  @media (max-width: 52rem) {
    .about-layout {
      grid-template-columns: 1fr;
    }

    .about-portrait {
      position: relative;
      top: auto;
      max-width: 36rem;
      margin: 1rem 0 0;
    }

    .about-portrait img {
      object-position: 56% center;
    }

    .about-copy {
      padding-top: 0;
    }

    .about-journey ol {
      grid-template-columns: 1fr;
    }

    .about-journey li:nth-child(even) {
      border-left: 0;
    }

    .about-journey li + li {
      border-top: 1px solid var(--color-line);
    }

    .education-columns,
    .about-closing {
      grid-template-columns: 1fr;
    }

    .closing-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 36rem) {
    .education-columns {
      gap: 3rem;
    }

    .about-closing {
      gap: 2rem;
    }
  }
</style>
