---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cvContent } from '../content/localized';
import { site } from '../content/site';
import type { Locale } from '../content/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const cvPage = cvContent[locale];
---

<BaseLayout title="CV" locale={locale} alternates={[{locale:'en',href:'/cv/'},{locale:'es',href:'/es/cv/'}]}>
  <section class="hero page-hero cv-hero" aria-labelledby="cv-title">
    <div class="hero-grid">
      <h1 id="cv-title">{cvPage.title}</h1>
      <div class="hero-copy">
        <p class="lead">{cvPage.introduction[0]}</p>
        <p class="language-note">{cvPage.languageNote}</p>
        <a
          class="text-link text-link--accent"
          href={cvPage.download.url}
          download
        >
          {cvPage.download.label}
        </a>
      </div>
    </div>
  </section>

  <section class="cv-summary" aria-labelledby="profile-title">
    <header class="section-heading">
      <h2 id="profile-title">{locale==='en'?'Professional profile':'Perfil profesional'}</h2>
    </header>

    <ul class="area-list" aria-label={locale==='en'?'Professional areas':'Áreas profesionales'}>
      {cvPage.areas.map((area) => <li>{area}</li>)}
    </ul>

    <ul class="highlight-list">
      {cvPage.highlights.map((highlight, index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <p>{highlight}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="cv-contact" aria-labelledby="cv-contact-title">
    <h2 id="cv-contact-title">{cvPage.contactTitle}</h2>
    <div class="contact-links">
      <a href={`mailto:${site.email}`}>
        <span>{cvPage.links.emailLabel}</span>
        {site.email}
      </a>
      <a href={site.linkedIn} target="_blank" rel="noopener noreferrer">
        <span>{cvPage.links.linkedInLabel}</span>
        linkedin.com/in/almuhernandez
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .language-note {
    margin-block: 1.75rem 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cv-summary {
    margin-bottom: clamp(5rem, 10vw, 9rem);
  }

  .cv-summary .section-heading {
    grid-template-columns: 1fr;
  }

  .area-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 2rem 0 clamp(3rem, 6vw, 5rem);
    padding: 0;
    list-style: none;
  }

  .area-list li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .area-list li::before {
    position: absolute;
    top: 0.42em;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-accent);
    content: "";
  }

  .highlight-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .highlight-list li {
    display: grid;
    grid-template-columns: minmax(2rem, 0.35fr) 1.65fr;
    gap: 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .highlight-list li:first-child {
    border-top: 1px solid var(--color-ink);
  }

  .highlight-list span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .highlight-list p {
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2.3rem);
    line-height: 1.15;
  }

  .cv-contact {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(3rem, 8vw, 8rem);
    padding: clamp(2rem, 5vw, 4rem);
    border-top: 0.6rem solid var(--color-accent);
    background: var(--color-soft);
  }

  .cv-contact h2 {
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .contact-links {
    display: grid;
  }

  .contact-links a {
    display: grid;
    grid-template-columns: minmax(5rem, 0.4fr) 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-ink);
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .contact-links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 0.3em;
  }

  .contact-links span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 50rem) {
    .highlight-list li,
    .cv-contact {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .contact-links a {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
