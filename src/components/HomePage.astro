---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeContent, servicesContent, aboutContent, contactContent } from '../content/localized';
import type { Locale } from '../content/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const home = homeContent[locale];
const services = servicesContent[locale];
const about = aboutContent[locale];
const contact = contactContent[locale];
const en = locale === 'en';
const resourcesHref = en ? '/students/' : '/es/estudiantes/';
const contactHref = en ? '/contact/' : '/es/contacto/';
---

<BaseLayout title={en ? 'Home' : 'Inicio'} locale={locale} alternates={[{locale:'en',href:'/'},{locale:'es',href:'/es/'}]}>
  <div class="landing">
    <section id="inicio" class="landing-hero" aria-labelledby="landing-title">
      <div class="hero-intro">
        <p class="eyebrow">{home.positioning}</p>
        <h1 id="landing-title">{home.title}</h1>
        <div class="hero-bottom">
          <div class="hero-description">
            {home.introduction.map((paragraph) => <p>{paragraph}</p>)}
            <div class="hero-actions">
              <a class="text-link text-link--accent" href="#servicios">{en ? 'Explore services' : 'Descubre mis servicios'}</a>
              <a class="text-link" href={resourcesHref}>{en ? 'Resources' : 'Recursos'}</a>
            </div>
          </div>
          <p class="hero-scroll">{en ? 'Scroll to explore ↓' : 'Desliza para descubrir ↓'}</p>
        </div>
      </div>
      <figure class="hero-image">
        <img src="/images/profesional.jpeg" alt={en ? 'Portrait of Almu Hernández' : 'Retrato de Almu Hernández'} width="1800" height="1200" />
      </figure>
    </section>

    <section id="servicios" class="landing-section services" aria-labelledby="services-title">
      <div class="section-topline"><span>01 / {en ? 'Services' : 'Servicios'}</span><span>{en ? 'What I do' : 'Qué puedo aportar'}</span></div>
      <div class="section-intro">
        <h2 id="services-title">{services.title}</h2>
        <p>{services.description}</p>
      </div>
      <div class="service-grid">
        {services.services.map((service) => <article class="service-card">
          <span class="service-number">{service.number}</span>
          <h3>{service.title}</h3>
          <p>{service.paragraphs[0]}</p>
        </article>)}
      </div>
      <a class="text-link" href={en ? '/services/' : '/es/servicios/'}>{en ? 'More about my services' : 'Conoce mis servicios'}</a>
    </section>

    <section id="sobre-mi" class="landing-section about" aria-labelledby="about-title">
      <div class="section-topline"><span>02 / {en ? 'About me' : 'Sobre mí'}</span><span>{en ? 'My background' : 'Mi trayectoria'}</span></div>
      <div class="about-grid">
        <figure><img src="/images/about.jpeg" alt={en ? 'Almu Hernández' : 'Almu Hernández'} loading="lazy" /></figure>
        <div class="about-copy">
          <h2 id="about-title">{about.title}</h2>
          {about.paragraphs.slice(0,3).map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href={en ? '/about/' : '/es/sobre-mi/'}>{en ? 'Read more about me' : 'Más sobre mí'}</a>
        </div>
      </div>
    </section>

    <section id="hablemos" class="landing-section contact" aria-labelledby="contact-title">
      <div class="section-topline"><span>03 / {en ? "Let's talk" : 'Hablemos'}</span><span>{en ? 'Get in touch' : 'Contacto'}</span></div>
      <div class="contact-grid">
        <h2 id="contact-title">{contact.headline}</h2>
        <div><p>{contact.introduction}</p><a class="text-link text-link--accent" href={contactHref}>{en ? 'Contact me' : 'Contacta conmigo'}</a></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .landing { width:100%; }
  .landing-hero { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr); min-height:min(48rem,90svh); gap:clamp(2rem,4vw,5rem); padding:clamp(1rem,3vw,3rem) 0 clamp(5rem,9vw,9rem); align-items:stretch; }
  .hero-intro { display:flex; flex-direction:column; justify-content:space-between; min-width:0; }
  .hero-intro h1 { max-width:13ch; font-size:clamp(3.7rem,6.6vw,8rem); line-height:.98; margin:clamp(2rem,5vw,5rem) 0; }
  .hero-bottom { display:flex; justify-content:space-between; align-items:end; gap:2rem; }
  .hero-description { max-width:31rem; }
  .hero-description p { font-size:clamp(1.1rem,1.5vw,1.4rem); line-height:1.5; }
  .hero-scroll { font-size:.7rem; text-transform:uppercase; letter-spacing:.12em; white-space:nowrap; writing-mode:vertical-rl; }
  .hero-image { margin:0; min-height:28rem; overflow:hidden; background:var(--color-line); }
  .hero-image img { width:100%; height:100%; object-fit:cover; object-position:center; }
  .landing-section { padding:clamp(5rem,9vw,9rem) 0; border-top:1px solid var(--color-ink); scroll-margin-top:2rem; }
  .section-topline { display:flex; justify-content:space-between; gap:1rem; margin-bottom:clamp(2.5rem,5vw,5rem); font-size:.75rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
  .section-intro { display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,6vw,6rem); align-items:end; margin-bottom:3rem; }
  .landing-section h2 { font-family:var(--font-display); font-weight:400; font-size:clamp(3rem,6vw,6rem); line-height:1; letter-spacing:-.05em; margin:0; }
  .section-intro p,.about-copy p,.contact-grid p { max-width:36rem; font-size:clamp(1.05rem,1.4vw,1.25rem); color:var(--color-muted); }
  .service-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin-bottom:2.5rem; border-block:1px solid var(--color-line); }
  .service-card { padding:2rem clamp(1rem,2.5vw,2.5rem) 3rem 0; }
  .service-card + .service-card { border-left:1px solid var(--color-line); padding-left:clamp(1rem,2.5vw,2.5rem); }
  .service-number { font-size:.8rem; color:var(--color-aubergine); }
  .service-card h3 { font-family:var(--font-display); font-size:clamp(1.8rem,2.6vw,2.8rem); font-weight:400; line-height:1.1; margin:4rem 0 1rem; }
  .service-card p { color:var(--color-muted); }
  .about-grid { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:clamp(2rem,8vw,9rem); align-items:center; }
  .about-grid figure { margin:0; aspect-ratio:4/5; overflow:hidden; }
  .about-grid img { width:100%; height:100%; object-fit:cover; }
  .about-copy h2 { margin-bottom:2rem; }
  .about-copy .text-link { margin-top:1rem; }
  .contact { padding-bottom:clamp(5rem,10vw,10rem); }
  .contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:end; }
  .contact-grid .text-link { margin-top:1.5rem; }
  @media(max-width:60rem) {
    .landing-hero { min-height:auto; grid-template-columns:1fr 1fr; }
    .hero-intro h1 { font-size:clamp(3rem,6vw,5rem); }
    .hero-bottom { align-items:start; }
    .hero-scroll { display:none; }
    .service-card h3 { margin-top:2rem; }
  }
  @media(max-width:46rem) {
    .landing-hero,.section-intro,.about-grid,.contact-grid { grid-template-columns:1fr; }
    .landing-hero { gap:2.5rem; }
    .hero-intro h1 { font-size:clamp(3.1rem,12vw,5.5rem); margin:2.5rem 0; }
    .hero-image { min-height:0; aspect-ratio:4/3; }
    .service-grid { grid-template-columns:1fr; }
    .service-card,.service-card + .service-card { border-left:0; padding:2rem 0; }
    .service-card + .service-card { border-top:1px solid var(--color-line); }
    .service-card h3 { margin-top:1rem; }
    .about-grid figure { max-height:30rem; }
  }
</style>
