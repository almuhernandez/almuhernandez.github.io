---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../content/i18n';
interface Props { locale: Locale }
const {locale}=Astro.props; const en=locale==='en';
const t=en?{
eyebrow:'DATA · AI · BUSINESS',titleA:'Data, context and',titleB:'business',titleC:'for better decisions.',lead:'I help turn data and complex problems into decisions, solutions and practical knowledge.',sub:'Analytics grounded in business context.',cta:'Explore how I work',painA:'Many companies have',painB:'data and technology',painC:'but struggle to turn them into decisions.',p1:'Dashboards that do not answer important questions. Data projects that never reach the business. And new AI tools without a clear application.',p2:'Meanwhile, decisions still rely on intuition, manual processes or disconnected information.',p3:'More data and more tools are not always the answer.',p4:'The key is connecting the business problem to the right analysis and technology.',servicesLabel:'How we can work together',servicesTitle:'Two ways to collaborate.',servicesIntro:'I connect data, AI and business context to solve real problems and share practical knowledge.',consult:'Data & AI Consulting',consultBody:'Support to define problems, develop analytical solutions and turn results into useful business decisions. AI is incorporated when it adds real value.',training:'Training and workshops',trainingBody:'Data Analytics training and mentoring, hands-on workshops and talks that connect concepts, tools and real business situations.',tags1:['Data strategy','Analytics and insights','Applied AI','Dashboards and decisions'],tags2:['Analytics training','AI workshops','Mentoring','Talks and workshops'],aboutLabel:'The person behind the data',aboutTitle:'Analytics with business context.',about1:'My background combines Physics and Statistics with over 15 years of experience in Analytics, Data Science and consulting across sectors and international teams.',about2:'I connect business questions with data, analysis and practical solutions that help people make decisions.',about3:'I also enjoy sharing what I have learned through training, mentoring and workshops.',contactLabel:'Contact',contactTitle:"Let's talk?",contactBody:'Have a challenge involving data, AI or business? Looking for a collaboration, workshop or talk? I would love to hear from you.',email:'Email me',resource:'Resources',marquee:[['15+ years of experience','white'],['Multiple industries','yellow',' · retail, banking, healthcare and digital'],['International','yellow',' · multidisciplinary teams']]}:{
eyebrow:'ANALYTICS · CONSULTORÍA · FORMACIÓN',titleA:'Datos, contexto y',titleB:'negocio',titleC:'para tomar mejores decisiones.',lead:'Ayudo a transformar datos y problemas complejos en decisiones, soluciones y conocimiento aplicable.',sub:'Analytics con contexto de negocio.',cta:'Descubre cómo trabajo',painA:'Muchas empresas tienen',painB:'datos y tecnología',painC:'pero les cuesta convertirlos en decisiones.',p1:'Dashboards que no responden a las preguntas importantes. Proyectos de datos que no llegan al negocio. Y nuevas herramientas de IA sin una aplicación clara.',p2:'Mientras tanto, las decisiones siguen dependiendo de intuiciones, procesos manuales o información desconectada.',p3:'No siempre hacen falta más datos ni más herramientas.',p4:'Hace falta conectar el problema de negocio con el análisis y la tecnología adecuados. Ahí es donde puedo ayudarte.',servicesLabel:'Cómo podemos colaborar',servicesTitle:'Dos formas de colaborar.',servicesIntro:'Conecto datos, IA y contexto de negocio para resolver problemas reales y compartir conocimiento que se pueda aplicar.',consult:'Consultoría de datos e IA',consultBody:'Apoyo para definir problemas, desarrollar soluciones analíticas y transformar resultados en decisiones útiles de negocio. La IA se incorpora cuando aporta valor real.',training:'Formación y talleres',trainingBody:'Formación y mentoring en Data Analytics, además de talleres prácticos y charlas que conectan conceptos, herramientas y situaciones reales de negocio.',tags1:['Estrategia de datos','Analytics e insights','IA aplicada','Dashboards y decisiones'],tags2:['Formación en Analytics','Talleres de IA','Mentoring','Charlas y talleres'],aboutLabel:'La persona detrás de los datos',aboutTitle:'Analytics con contexto de negocio.',about1:'Mi trayectoria combina formación en Física y Estadística con más de 15 años de experiencia en Analytics, Data Science y consultoría en diferentes sectores y entornos internacionales.',about2:'He trabajado conectando preguntas de negocio con datos, análisis y soluciones que ayudan a tomar decisiones. Me interesa que la tecnología —incluida la IA— tenga un propósito claro.',about3:'También disfruto compartiendo lo aprendido a través de la formación, el mentoring y los talleres.',contactLabel:'Contacto',contactTitle:'¿Hablamos?',contactBody:'Si tienes un reto relacionado con datos, IA o negocio, o buscas una colaboración, formación o charla, estaré encantada de escucharte.',email:'Escríbeme',resource:'Recursos',marquee:[['+15 años de experiencia','white'],['Múltiples sectores','yellow',' · retail, banca, salud y digital'],['Internacional','yellow',' · equipos multidisciplinares']]};
---
<BaseLayout title={en?'Home':'Inicio'} locale={locale} alternates={[{locale:'es',href:'/es/'},{locale:'en',href:'/'}]}>
<div class="almu-landing">
<section id="inicio" class="almu-hero">
 <div class="almu-photo"><img src="/images/about.jpeg" alt={en?'Almu Hernández portrait':'Retrato de Almu Hernández'} fetchpriority="high" /></div>
 <div class="almu-hero-copy"><p class="almu-eyebrow">{t.eyebrow}</p><h1>{t.titleA} <em>{t.titleB}</em> {t.titleC}</h1><p class="almu-lead">{t.lead}</p><p class="almu-sub">{t.sub}</p><a class="almu-btn" href="#servicios">{t.cta}</a></div>
</section>
<div class="almu-marquee" aria-label={t.marquee.join('. ')}><div class="almu-marquee-track">{Array.from({length:4}).map(()=> <div class="almu-marquee-set">{t.marquee.map(([item,tone,detail])=><span><span class:list={{'almu-marquee-yellow':tone==='yellow'}}>{item}</span>{detail && <span class="almu-marquee-detail">{detail}</span>}<b>✳</b></span>)}</div>)}</div></div>
<section class="almu-problem" aria-labelledby="problem-heading"><div class="almu-problem-mark" aria-hidden="true">✳</div><div><h2 id="problem-heading">{t.painA} <u>{t.painB}</u>, {t.painC}</h2><div class="almu-problem-text"><p><strong>{t.p1}</strong></p><p><strong>{t.p2}</strong></p><p>{t.p3}</p><p>{t.p4}</p></div></div></section>
<section id="servicios" class="almu-services"><p class="almu-eyebrow">{t.servicesLabel}</p><div class="almu-services-intro"><h2>{t.servicesTitle}</h2><p>{t.servicesIntro}</p></div><div class="almu-cards"><article class="almu-card almu-card-dark"><h3>{t.consult}</h3><p>{t.consultBody}</p><div class="almu-tags">{t.tags1.map(tag=><span>{tag}</span>)}</div></article><article class="almu-card almu-card-plum"><h3>{t.training}</h3><p>{t.trainingBody}</p><div class="almu-tags">{t.tags2.map(tag=><span>{tag}</span>)}</div></article></div></section>
<section id="sobre-mi" class="almu-about"><div class="almu-about-image"><img src="/images/profesional.jpeg" loading="lazy" alt={en?'Almu Hernández sitting outdoors':'Almu Hernández sentada en un sofá'} /></div><div><p class="almu-eyebrow">{t.aboutLabel}</p><h2>{t.aboutTitle}</h2><p>{t.about1}</p><p>{t.about2}</p><p>{t.about3}</p></div></section>
<section id="hablemos" class="almu-contact"><div><p class="almu-eyebrow">{t.contactLabel}</p><h2>{t.contactTitle}</h2></div><div><p>{t.contactBody}</p><div class="almu-actions"><a class="almu-btn" href="mailto:info@almuhernandez.com">{t.email} ↗</a><a class="almu-btn almu-btn-outline" href="https://www.linkedin.com/in/almuhernandez" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div></section>
</div>
</BaseLayout>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');
/* Current palette and layout refinements */
.almu-landing{font-family:'DM Sans',sans-serif;color:#242124;background:#f1e8de}.almu-landing h1,.almu-landing h2,.almu-landing h3{font-family:'Playfair Display',Georgia,serif;font-weight:400;letter-spacing:-.045em}.almu-hero{display:grid;grid-template-columns:50% 50%;min-height:680px}.almu-photo{min-height:650px;overflow:hidden}.almu-photo img{width:100%;height:100%;object-fit:cover;object-position:center}.almu-hero-copy{padding:clamp(60px,8vw,135px) clamp(35px,5vw,85px);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.almu-eyebrow{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.almu-hero h1{font-size:clamp(46px,4.5vw,80px);line-height:1.15;max-width:16ch;margin:35px auto}.almu-hero h1 em{color:#4b123b;font-weight:400}.almu-lead{font-size:18px;max-width:440px}.almu-sub{font-weight:700;margin:8px 0 35px}.almu-btn{display:inline-block;background:#4b123b;color:white;text-decoration:none;padding:15px 25px;text-transform:uppercase;font-size:12px;font-weight:700;letter-spacing:.1em;transition:background .2s,color .2s}.almu-btn:hover{background:#e9c75f;color:#242124}.almu-marquee{background:#4b123b;color:white;overflow:hidden;padding:31px 0;font-size:clamp(16px,1.65vw,24px);font-weight:600;line-height:1.35}.almu-marquee-track{display:flex;width:max-content;animation:almu-scroll 38s linear infinite}.almu-marquee-set{display:flex;flex:none;gap:30px;padding-right:30px;white-space:nowrap}.almu-marquee-set span{display:flex;gap:30px;align-items:center}.almu-marquee-set b{color:#e9c75f}.almu-marquee-set .almu-marquee-yellow{color:#e9c75f}.almu-marquee-set .almu-marquee-detail{color:#fff}@keyframes almu-scroll{to{transform:translateX(-50%)}}.almu-problem{display:grid;grid-template-columns:25% 75%;padding:clamp(40px,5vw,75px) clamp(28px,8vw,130px);gap:30px;background:#f8f6f3}.almu-problem-mark{color:#e9c75f;font-size:clamp(70px,10vw,150px);line-height:1}.almu-problem h2{font-size:clamp(38px,4vw,68px);line-height:1.1;max-width:950px}.almu-problem h2 u{text-decoration-thickness:2px;text-underline-offset:8px}.almu-problem-text{max-width:750px;margin:28px 0 0 auto;font-size:17px}.almu-problem-text p{margin-bottom:22px}.almu-services{padding:85px clamp(28px,7vw,120px);background:#e9e1d9}.almu-services-intro{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:end;margin-bottom:50px}.almu-services h2,.almu-about h2,.almu-contact h2{font-size:clamp(45px,5.2vw,90px);line-height:1.08}.almu-services-intro p{font-size:18px;max-width:460px}.almu-cards{display:grid;grid-template-columns:repeat(2,minmax(0,460px));gap:22px;justify-content:center}.almu-card{padding:clamp(22px,2.3vw,38px);min-height:0;aspect-ratio:1/1;display:flex;flex-direction:column}.almu-card-dark{background:#171717;color:#fff}.almu-card-plum{background:#4b123b;color:#fff}.almu-card h3{font-size:clamp(28px,2.4vw,42px);margin-bottom:25px}.almu-card p{font-size:clamp(14px,1.1vw,17px);line-height:1.55}.almu-tags{display:flex;gap:10px;flex-wrap:wrap;border-top:1px solid #ffffff77;margin-top:auto;padding-top:25px}.almu-tags span{border:1px solid #ffffff88;padding:7px 10px;font-size:11px}.almu-about{display:grid;grid-template-columns:42% 1fr;gap:clamp(35px,6vw,110px);background:#4b123b;color:white;padding:clamp(60px,7vw,110px)}.almu-about-image{min-height:530px;overflow:hidden}.almu-about-image img{width:100%;height:100%;object-fit:cover}.almu-about h2{margin:25px 0 40px}.almu-about p:not(.almu-eyebrow){font-size:17px;line-height:1.85;max-width:620px}.almu-contact{display:grid;grid-template-columns:1fr 1fr;gap:65px;background:#f8f6f3;padding:clamp(80px,10vw,160px) clamp(30px,8vw,130px)}.almu-contact p:not(.almu-eyebrow){font-size:19px;line-height:1.7}.almu-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:35px}.almu-btn-outline{background:transparent;color:#4b123b;border:1px solid #4b123b}.almu-btn-outline:hover{border-color:#e9c75f}@media(max-width:800px){.almu-hero{grid-template-columns:1fr}.almu-photo{min-height:420px;max-height:520px}.almu-hero-copy{padding:65px 25px}.almu-problem{grid-template-columns:1fr;padding:48px 25px}.almu-problem-mark{font-size:75px}.almu-services{padding:65px 25px}.almu-services-intro,.almu-cards,.almu-about,.almu-contact{grid-template-columns:1fr}.almu-cards{max-width:460px;margin-inline:auto}.almu-card{aspect-ratio:auto;min-height:370px}.almu-about{padding:60px 25px}.almu-about-image{min-height:350px}.almu-contact{padding:75px 25px}.almu-services h2,.almu-about h2,.almu-contact h2{font-size:50px}}@media(prefers-reduced-motion:reduce){.almu-marquee-track{animation:none}}
</style>