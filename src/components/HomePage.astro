---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../content/i18n';
interface Props { locale: Locale }
const {locale}=Astro.props; const en=locale==='en';
const t=en?{
eyebrow:'ANALYTICS · AI · CONSULTING · TRAINING',titleA:'Data and AI for',titleB:'better decisions.',titleC:'',lead:'I help people and organizations understand and use data and AI to solve real problems, make informed decisions and improve the way they work.',sub:'',cta:'Discover how I can help',painA:'Many companies have',painB:'data and technology',painC:'but struggle to turn them into decisions.',p1:'Dashboards that do not answer important questions. Data projects that never reach the business. And new AI tools without a clear application.',p2:'Meanwhile, decisions still rely on intuition, manual processes or disconnected information.',p3:'More data and more tools are not always the answer.',p4:'The key is connecting the business problem to the right analysis and technology.',p5:'That is where I can help.',servicesLabel:'How I can help',servicesTitle:'Four ways to collaborate.',servicesIntro:'',consult:'Data & AI Consulting',consultBody:'Support to define problems, develop analytical solutions and turn results into useful business decisions.',training:'Tailored training for teams',trainingBody:'Practical data, Analytics and AI training designed for each team and organization.',education:'Teaching, talks and workshops',educationBody:'Teaching, practical workshops and talks connecting concepts, tools and real business situations.',audienceBusiness:'COMPANIES AND ORGANIZATIONS',audienceEducation:'SCHOOLS, UNIVERSITIES AND ORGANIZATIONS',tags3:['Teaching','Talks','Workshops','Mentoring'],tags1:['Data strategy','Analytics and insights','Applied AI','Dashboards and decisions'],tags2:['Tailored programs','Analytics','Applied AI','Teams'],courses:'Courses for data analysts',coursesBody:'Practical courses for analysts at different stages who want to build, apply and deepen their analytics skills.',coursesAudience:'LEARNERS AND ANALYSTS',tags4:['Data Analytics','Practice','Skills','Professional growth'],consultCta:'Explore case studies',otherCta:'Let’s talk',aboutLabel:'The person behind the data',aboutTitle:'Analytics with business context.',about1:'My background combines Physics and Statistics with over 15 years of experience in Analytics, Data Science and consulting across sectors and international teams.',about2:'I connect business questions with data, analysis and practical solutions that help people make decisions.',about3:'I also enjoy sharing what I have learned through training, mentoring and workshops.',contactLabel:'Contact',contactTitle:"Let's talk?",contactBody:'Have a challenge involving data, AI or business? Looking for a collaboration, workshop or talk? I would love to hear from you.',email:'Email me',resource:'Resources',marquee:[['15+ years of experience','white'],['Multiple industries','yellow',': retail, banking, healthcare and digital'],['International','yellow',': different countries and multidisciplinary teams']]}:{
eyebrow:'ANALYTICS · IA · CONSULTORÍA · FORMACIÓN',titleA:'Datos e IA para tomar',titleB:'mejores decisiones.',titleC:'',lead:'Ayudo a personas y organizaciones a entender y utilizar los datos y la IA para resolver problemas reales, tomar decisiones con criterio y mejorar su forma de trabajar.',sub:'',cta:'Descubre cómo puedo ayudarte',painA:'Muchas empresas tienen',painB:'datos y tecnología',painC:'pero les cuesta convertirlos en decisiones.',p1:'Dashboards que no responden a las preguntas importantes. Proyectos de datos que no llegan al negocio. Y nuevas herramientas de IA sin una aplicación clara.',p2:'Mientras tanto, las decisiones siguen dependiendo de intuiciones, procesos manuales o información desconectada.',p3:'No siempre hacen falta más datos ni más herramientas.',p4:'Hace falta conectar el problema de negocio con el análisis y la tecnología adecuados.',p5:'Ahí es donde puedo ayudarte.',servicesLabel:'Cómo puedo ayudarte',servicesTitle:'Cuatro formas de colaborar.',servicesIntro:'',consult:'Consultoría de datos e IA',consultBody:'Apoyo para definir problemas, desarrollar soluciones analíticas y transformar resultados en decisiones útiles de negocio.',training:'Formación a medida para equipos',trainingBody:'Formación práctica en datos, Analytics e IA diseñada para los equipos y los retos de cada organización.',education:'Docencia, charlas y talleres',educationBody:'Docencia, talleres prácticos y charlas que conectan conceptos, herramientas y situaciones reales de negocio.',audienceBusiness:'EMPRESAS Y ORGANIZACIONES',audienceEducation:'ESCUELAS, UNIVERSIDADES Y ORGANIZACIONES',tags3:['Docencia','Charlas','Talleres','Mentoring'],tags1:['Estrategia de datos','Analytics e insights','IA aplicada','Dashboards y decisiones'],tags2:['Programas a medida','Analytics','IA aplicada','Equipos'],courses:'Cursos para analistas de datos',coursesBody:'Cursos prácticos para quienes quieren desarrollar, aplicar y profundizar sus conocimientos en análisis de datos, en cualquier etapa de su aprendizaje.',coursesAudience:'ESTUDIANTES Y ANALISTAS',tags4:['Data Analytics','Práctica','Herramientas','Desarrollo profesional'],consultCta:'Ver casos de uso',otherCta:'Hablemos',aboutLabel:'La persona detrás de los datos',aboutTitle:'Analytics con contexto de negocio.',about1:'Mi trayectoria combina formación en Física y Estadística con más de 15 años de experiencia en Analytics, Data Science y consultoría en diferentes sectores y entornos internacionales.',about2:'He trabajado conectando preguntas de negocio con datos, análisis y soluciones que ayudan a tomar decisiones. Me interesa que la tecnología —incluida la IA— tenga un propósito claro.',about3:'También disfruto compartiendo lo aprendido a través de la formación, el mentoring y los talleres.',contactLabel:'Contacto',contactTitle:'¿Hablamos?',contactBody:'Si tienes un reto relacionado con datos, IA o negocio, o buscas una colaboración, formación o charla, estaré encantada de escucharte.',email:'Escríbeme',resource:'Recursos',marquee:[['+15 años de experiencia','white'],['Múltiples sectores','yellow',': retail, banca, salud y digital'],['Internacional','yellow',': distintos países y equipos multidisciplinares']]};
---
<BaseLayout title={en?'Home':'Inicio'} locale={locale} alternates={[{locale:'es',href:'/es/'},{locale:'en',href:'/'}]}>
<div class="almu-landing">
<section id="inicio" class="almu-hero">
 <div class="almu-photo"><img src="/images/hero-almu.jpeg" alt={en?'Almu Hernández portrait':'Retrato de Almu Hernández'} fetchpriority="high" /></div>
 <div class="almu-hero-copy"><p class="almu-eyebrow">{t.eyebrow}</p><h1>{t.titleA} <em>{t.titleB}</em> {t.titleC}</h1><p class="almu-lead">{t.lead}</p>{t.sub && <p class="almu-sub">{t.sub}</p>}<a class="almu-btn" href="#servicios">{t.cta}</a></div>
</section>
<div class="almu-marquee" aria-label={t.marquee.join('. ')}><div class="almu-marquee-track">{Array.from({length:4}).map(()=> <div class="almu-marquee-set">{t.marquee.map(([item,tone,detail])=><span><span class:list={{'almu-marquee-yellow':tone==='yellow'}}>{item}</span>{detail && <span class="almu-marquee-detail">{detail}</span>}{tone==='yellow' && <b>✳</b>}</span>)}</div>)}</div></div>
<section class="almu-problem" aria-labelledby="problem-heading"><div class="almu-problem-mark" aria-hidden="true">✳</div><div><h2 id="problem-heading">{t.painA} <span class="almu-problem-accent">{t.painB}</span>, {t.painC}</h2><div class="almu-problem-text"><p>{t.p1}</p><p>{t.p2}</p><p>{t.p3}</p><p class="almu-problem-highlight">{t.p4}</p><p>{t.p5}</p></div></div></section>
<section id="servicios" class="almu-services"><p class="almu-eyebrow">{t.servicesLabel}</p><div class="almu-services-intro"><h2>{t.servicesTitle}</h2></div><div class="almu-cards">
<article class="almu-card almu-card-dark"><span class="almu-card-audience">01 / {t.audienceBusiness}</span><h3>{t.consult}</h3><p>{t.consultBody}</p><div class="almu-tags">{t.tags1.map(tag=><span>{tag}</span>)}</div><a class="almu-card-cta" href={en?'/consulting/case-studies/':'/es/consultoria/casos-de-uso/'}>{t.consultCta} ↗</a></article>
<article class="almu-card almu-card-plum"><span class="almu-card-audience">02 / {t.audienceBusiness}</span><h3>{t.training}</h3><p>{t.trainingBody}</p><div class="almu-tags">{t.tags2.map(tag=><span>{tag}</span>)}</div><a class="almu-card-cta" href="#hablemos">{t.otherCta} ↗</a></article>
<article class="almu-card almu-card-yellow"><span class="almu-card-audience">03 / {t.audienceEducation}</span><h3>{t.education}</h3><p>{t.educationBody}</p><div class="almu-tags">{t.tags3.map(tag=><span>{tag}</span>)}</div><a class="almu-card-cta" href="#hablemos">{t.otherCta} ↗</a></article>
<article class="almu-card almu-card-cream"><span class="almu-card-audience">04 / {t.coursesAudience}</span><h3>{t.courses}</h3><p>{t.coursesBody}</p><div class="almu-tags">{t.tags4.map(tag=><span>{tag}</span>)}</div><a class="almu-card-cta" href="#hablemos">{t.otherCta} ↗</a></article>
</div></section>
<section id="sobre-mi" class="almu-about"><div class="almu-about-image"><img src="/images/profesional.jpeg" loading="lazy" alt={en?'Almu Hernández sitting outdoors':'Almu Hernández sentada en un sofá'} /></div><div><p class="almu-eyebrow">{t.aboutLabel}</p><h2>{t.aboutTitle}</h2><p>{t.about1}</p><p>{t.about2}</p><p>{t.about3}</p></div></section>
<section id="hablemos" class="almu-contact"><div><p class="almu-eyebrow">{t.contactLabel}</p><h2>{t.contactTitle}</h2></div><div><p>{t.contactBody}</p><div class="almu-actions"><a class="almu-btn" href="mailto:info@almuhernandez.com">{t.email} ↗</a><a class="almu-btn almu-btn-outline" href="https://www.linkedin.com/in/almuhernandez" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div></section>
</div>
</BaseLayout>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');
/* Current palette and layout refinements */
.almu-landing{font-family:'DM Sans',sans-serif;color:#242124;background:#f1e8de}.almu-landing h1,.almu-landing h2,.almu-landing h3{font-family:'Playfair Display',Georgia,serif;font-weight:400;letter-spacing:-.045em}.almu-hero{display:grid;grid-template-columns:minmax(0,44%) minmax(0,56%);height:auto;min-height:610px;align-items:stretch;overflow:hidden}.almu-photo{position:relative;min-height:610px;overflow:hidden;background:#f1e8de}.almu-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;display:block}.almu-hero-copy{min-width:0;padding:clamp(60px,8vw,135px) clamp(35px,5vw,85px);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.almu-eyebrow{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.almu-hero h1{font-size:clamp(46px,4.5vw,80px);line-height:1.15;max-width:16ch;margin:35px auto}.almu-hero h1 em{color:#4b123b;font-weight:400}.almu-lead{font-size:18px;max-width:440px}.almu-sub{font-weight:700;margin:8px 0 35px}.almu-btn{display:inline-block;background:#4b123b;color:white;text-decoration:none;padding:15px 25px;text-transform:uppercase;font-size:12px;font-weight:700;letter-spacing:.1em;transition:background .2s,color .2s}.almu-btn:hover{background:#e9c75f;color:#242124}.almu-marquee{background:#4b123b;color:white;overflow:hidden;padding:40px 0;font-size:clamp(17px,1.55vw,21px);font-weight:400;line-height:1.35}.almu-marquee-yellow{font-size:clamp(20px,1.9vw,25px);font-weight:600}.almu-marquee-track{display:flex;width:max-content;animation:almu-scroll 38s linear infinite}.almu-marquee-set{display:flex;flex:none;gap:30px;padding-right:30px;white-space:nowrap}.almu-marquee-set > span{display:flex;gap:0;align-items:center}.almu-marquee-set > span > b{margin-left:30px}.almu-marquee-set b{color:#e9c75f}.almu-marquee-set .almu-marquee-yellow{color:#e9c75f}.almu-marquee-set .almu-marquee-detail{color:#fff;margin-left:5px}@keyframes almu-scroll{to{transform:translateX(-50%)}}.almu-problem{display:grid;grid-template-columns:25% 75%;padding:clamp(36px,4vw,65px) clamp(28px,8vw,130px);gap:30px;background:#171717;color:#eee8e3}.almu-problem-mark{color:#e9c75f;font-size:clamp(70px,10vw,150px);line-height:1}.almu-problem h2{font-size:clamp(33px,3.2vw,53px);line-height:1.23;max-width:950px;font-weight:400;letter-spacing:-.035em;color:#fff}.almu-problem h2 .almu-problem-accent{color:#e9c75f;text-decoration:none}.almu-problem-text{max-width:750px;margin:28px auto 0 0;font-size:clamp(16px,1.25vw,19px);line-height:1.65;font-weight:400;color:#eee8e3}.almu-problem-text p{margin-bottom:22px;font-weight:400}.almu-problem-text strong{font-weight:400}.almu-problem-text .almu-problem-highlight{color:#e9c75f;font-size:clamp(18px,1.45vw,22px);font-weight:500;line-height:1.55;margin-top:24px;margin-bottom:12px}.almu-services{padding:85px clamp(28px,7vw,120px);background:#e9e1d9}.almu-services-intro{display:block;margin-bottom:50px}.almu-services h2,.almu-about h2,.almu-contact h2{font-size:clamp(45px,5.2vw,90px);line-height:1.08}.almu-services-intro p{font-size:18px;max-width:460px}.almu-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(12px,1.6vw,25px);width:100%;margin-inline:0}.almu-card-plum{transform:none}.almu-card{padding:clamp(20px,2vw,34px);min-height:440px;display:flex;flex-direction:column}.almu-card-dark{background:#171717;color:#fff}.almu-card-plum{background:#4b123b;color:#fff}.almu-card-yellow{background:#e9c75f;color:#171717}.almu-card-cream{background:#f1e8de;color:#171717}.almu-card-audience{font-size:11px;letter-spacing:.14em;color:#e9c75f;line-height:1.5;font-weight:600}.almu-card h3{font-size:clamp(24px,2.1vw,38px);margin:20px 0 14px}.almu-card p{font-size:clamp(14px,1.1vw,16px);line-height:1.5;margin-bottom:15px}.almu-tags{display:flex;gap:6px;flex-wrap:wrap;border-top:1px solid currentColor;margin-top:auto;padding-top:13px;opacity:.85}.almu-tags span{border:1px solid currentColor;padding:6px 9px;font-size:11px}.almu-card-yellow .almu-card-audience,.almu-card-cream .almu-card-audience{color:#4b123b}.almu-card-cta{display:inline-flex;align-self:flex-start;margin-top:24px;padding-bottom:5px;border-bottom:2px solid currentColor;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;text-decoration:none}.almu-card-cta:hover{opacity:.7}.almu-about{display:grid;grid-template-columns:42% 1fr;gap:clamp(35px,6vw,110px);background:#4b123b;color:white;padding:clamp(60px,7vw,110px)}.almu-about-image{min-height:530px;overflow:hidden}.almu-about-image img{width:100%;height:100%;object-fit:cover}.almu-about h2{margin:25px 0 40px}.almu-about p:not(.almu-eyebrow){font-size:17px;line-height:1.85;max-width:620px} .almu-contact{display:grid;grid-template-columns:1fr 1fr;gap:65px;background:#f1e8de;padding:clamp(80px,10vw,160px) clamp(30px,8vw,130px)}.almu-contact p:not(.almu-eyebrow){font-size:19px;line-height:1.7}.almu-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:35px}.almu-btn-outline{background:transparent;color:#4b123b;border:1px solid #4b123b}.almu-btn-outline:hover{border-color:#e9c75f}@media(max-width:1180px){.almu-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.almu-cards{grid-template-columns:1fr}}@media(max-width:800px){.almu-hero{grid-template-columns:1fr;height:auto;min-height:0}.almu-photo{height:430px;min-height:430px;max-height:none}.almu-hero-copy{padding:65px 25px}.almu-problem{grid-template-columns:1fr;padding:38px 25px}.almu-problem-mark{font-size:75px}.almu-services{padding:65px 25px}.almu-services-intro,.almu-cards,.almu-about,.almu-contact{grid-template-columns:1fr}.almu-cards{max-width:540px;margin-inline:auto;gap:22px}.almu-card-plum{transform:none}.almu-card{aspect-ratio:auto;min-height:370px}.almu-about{padding:60px 25px}.almu-about-image{min-height:350px}.almu-contact{padding:75px 25px}.almu-services h2,.almu-about h2,.almu-contact h2{font-size:50px}}@media(prefers-reduced-motion:reduce){.almu-marquee-track{animation:none}}

/* Keep the moving band in its own layout and paint layer, below the hero. */
.almu-landing{display:flow-root}
.almu-hero{position:relative;z-index:0;isolation:isolate;overflow:clip;grid-auto-rows:auto}
.almu-photo{align-self:stretch;overflow:hidden;min-height:610px}
.almu-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.almu-hero-copy{position:relative;z-index:1}
.almu-marquee{position:relative;z-index:0;display:block;clear:both;isolation:isolate;overflow:hidden;clip-path:inset(0);width:100%;max-width:100%;box-sizing:border-box}
.almu-marquee-track{position:relative;will-change:transform}
.almu-problem{position:relative;clear:both}
@media(max-width:800px){.almu-hero{display:flex;flex-direction:column}.almu-photo{position:relative;flex:0 0 430px;height:430px;min-height:430px}.almu-photo img{position:absolute;inset:0}.almu-hero-copy{flex:0 0 auto}}
</style>