---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeCaseStudies, homeContent } from '../content/localized';
import { expertiseContent } from '../content/expertise';
import { caseStudies } from '../content/projects';
import { caseStudyPath } from '../content/i18n';
import type { Locale } from '../content/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const home = homeContent[locale];
const expertise = expertiseContent;
const caseCopy=homeCaseStudies[locale];
const selectedCaseStudies=['customer-segmentation','customer-churn-retention','pricing-revenue-analysis'].map(slug=>caseStudies.find(item=>item.slug===slug)).filter(Boolean);
const localHref=(href:string)=>locale==='en'?(href==='/estudiantes/'?'/students/':href):({'/contacto/':'/es/contacto/','/experiencia/':'/es/experiencia/','/servicios/':'/es/servicios/','/estudiantes/':'/es/estudiantes/'}[href]??href);
---

<BaseLayout title={locale === 'en' ? 'Home' : 'Inicio'} locale={locale} alternates={[{locale:'en',href:'/'},{locale:'es',href:'/es/'}]}>
  <div class:list={['home', {'home--en':locale==='en'}]}>
    <section class="home-hero" aria-labelledby="home-title">
      <p class="eyebrow">{home.positioning}</p>
      <div class="home-hero-grid">
        <div class="home-heading">
          <h1 id="home-title">{home.title}</h1>
        </div>
        <figure class="home-portrait">
          <img
            src="/images/profesional.jpeg"
            alt={locale==='en'?'Professional portrait of Almu Hernández':'Retrato profesional de Almu Hernández'}
            width="1800"
            height="1200"
          />
        </figure>
        <div class="hero-copy">
          {home.introduction.map((paragraph, index) => (
            <p class={index === 0 ? 'lead' : undefined}>{paragraph}</p>
          ))}
          <div class="hero-actions">
            <a class="text-link text-link--accent" href={localHref(home.primaryLink.href)}>
              {home.primaryLink.label}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="areas" id="areas" aria-labelledby="areas-title">
      <header class="section-heading">
        <h2 id="areas-title">{expertise.homeTitle[locale]}</h2>
        <p>{expertise.homeIntroduction[locale]}</p>
      </header>
      <div class="area-list">
        {expertise.areas.map((area) => (
          <article class="area">
            <p class="area-number" aria-hidden="true">{area.number}</p>
            <h3>{area.title[locale]}</h3>
            <p>{area.homeSkills[locale].join(' · ')}</p>
          </article>
        ))}
      </div>
      <footer class="areas-footer">
        <div>
          <p>{expertise.coreToolkit.label[locale]}</p>
          <p class="core-toolkit">{expertise.coreToolkit.items.join(' · ')}</p>
        </div>
        <nav aria-label={locale==='en'?'Explore analytics capabilities in depth':'Profundizar en capacidades analíticas'}>
          <a class="text-link" href={locale==='en'?'/about/#experiencia-analitica':'/es/sobre-mi/#experiencia-analitica'}>{expertise.homeLinks.about.label[locale]}</a>
          <a class="text-link text-link--accent" href={locale==='en'?'/projects/':expertise.homeLinks.work.href[locale]}>{expertise.homeLinks.work.label[locale]}</a>
        </nav>
      </footer>
    </section>

    <section class="experience-highlight" aria-labelledby="experience-title">
      <div class="experience-heading">
        <p class="experience-value">{home.experience.value}</p>
        <h2 id="experience-title">{home.experience.label}</h2>
      </div>
      <div class="experience-scope">
        <div>
          <p class="experience-label">{locale==='en'?'Sectors':'Sectores'}</p>
          <p>{home.experience.sectors}</p>
        </div>
        <div>
          <p class="experience-label">{locale==='en'?'International environments':'Entornos internacionales'}</p>
          <p>{home.experience.internationalEnvironments}</p>
        </div>
        <p class="experience-statement">{home.experience.statement}</p>
      </div>
    </section>

    <section class="home-case-studies" aria-labelledby="home-case-studies-title">
      <header class="case-studies-heading">
        <h2 id="home-case-studies-title">{caseCopy.title}</h2>
        <p>{caseCopy.introduction}</p>
      </header>
      <div class="case-study-preview-grid">
        {selectedCaseStudies.map((caseStudy,index)=><article>
          <p class="case-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</p>
          <p class="case-category">{caseStudy.category[locale]}</p>
          <h3>{caseStudy.title[locale]}</h3>
          <p>{caseStudy.question[locale]}</p>
          <a class="text-link" href={caseStudyPath(locale,caseStudy.slug)}>{locale==='en'?'Explore case study':'Explorar caso práctico'}</a>
        </article>)}
      </div>
      <a class="text-link text-link--accent case-studies-cta" href={`${locale==='en'?'/projects/':'/es/proyectos/'}#library-title`}>{caseCopy.cta}</a>
    </section>

    <section class="home-pathways" aria-label={locale==='en'?'Explore the portfolio':'Explorar el portfolio'}>
      {home.pathways.map((pathway, index) => (
        <article
          class:list={[
            'pathway',
            {
              'pathway--primary': index === 0,
              'pathway--services': index === 1,
              'pathway--students': index === 2,
            },
          ]}
        >
          <p class="pathway-number" aria-hidden="true">{pathway.number}</p>
          <h2>{pathway.title}</h2>
          <p>{pathway.description}</p>
          {'link' in pathway ? (
            <a class="text-link" href={localHref(pathway.link.href)}>
              {pathway.link.label}
            </a>
          ) : (
            <p class="pathway-status">{pathway.status}</p>
          )}
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .home-hero {
    padding: clamp(1rem, 3vw, 2rem) 0 clamp(6rem, 11vw, 10rem);
  }

  .home-hero > .eyebrow {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .home-hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: 1.5rem clamp(1rem, 2vw, 2rem);
    align-items: start;
  }

  .home-heading {
    z-index: 1;
    grid-column: 1 / 8;
    grid-row: 1;
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
  }

  .home-heading h1 {
    position: relative;
    max-width: none;
    padding-bottom: clamp(1.1rem, 2vw, 1.5rem);
    font-size: clamp(3.3rem, 5vw, 5.25rem);
  }

  .home-heading h1::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: clamp(5rem, 10vw, 9rem);
    height: 0.5rem;
    background: var(--color-title-accent);
    content: "";
  }

  .home-portrait {
    position: relative;
    grid-column: 8 / 13;
    grid-row: 1 / 3;
    align-self: start;
    aspect-ratio: 1 / 1;
    margin: clamp(4rem, 8vw, 7rem) 0 0;
  }

  .home-portrait::before {
    position: absolute;
    inset: 1.25rem -1rem -1.25rem 1.25rem;
    z-index: -1;
    background: var(--color-accent);
    content: "";
  }

  .home-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% center;
  }

  .home-hero .hero-copy {
    grid-column: 1 / 7;
    grid-row: 2;
    max-width: 38rem;
    padding: 1.75rem 2.5rem 0 0;
    background: var(--color-paper);
  }

  .areas .area-number {
    color: var(--color-ink);
  }

  .areas .section-heading {
    grid-template-columns: minmax(16rem, 1fr) minmax(20rem, 0.8fr);
  }

  .areas .area-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
  }

  .areas .area {
    display: block;
    grid-column: span 2;
    min-height: 18rem;
    padding: 2rem 1.25rem;
    border-bottom: 0;
  }

  .areas .area + .area {
    border-left: 1px solid var(--color-line);
  }

  .areas .area:nth-child(4) {
    grid-column: 1 / span 3;
    border-top: 1px solid var(--color-line);
    border-left: 0;
  }

  .areas .area:nth-child(5) {
    grid-column: 4 / span 3;
    border-top: 1px solid var(--color-line);
  }

  .areas .area h3 {
    margin: clamp(2.5rem, 5vw, 4rem) 0 1.25rem;
  }

  .areas .area > p:last-child {
    color: var(--color-muted);
  }

  .areas-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .areas-footer > div > p:first-child {
    margin-bottom: 0.5rem;
    color: var(--color-aubergine);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .core-toolkit {
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 2rem);
  }

  .areas-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: flex-end;
  }

  .experience-highlight {
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    align-items: stretch;
  }

  .experience-heading {
    justify-content: space-between;
  }

  .experience-scope {
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-left: clamp(0rem, 3vw, 3rem);
    border-left: 1px solid rgb(250 247 243 / 35%);
  }

  .experience-scope p {
    margin-bottom: 0;
  }

  .experience-label {
    margin-bottom: 0.35rem !important;
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .experience-statement {
    max-width: 34rem;
    padding-top: 1.5rem;
    border-top: 1px solid #4b4b48;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.3;
  }

  .home-case-studies {
    margin-top: clamp(6rem, 12vw, 11rem);
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
  }

  .case-studies-heading {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) minmax(20rem, 0.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .case-studies-heading h2 {
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .case-studies-heading p {
    margin-bottom: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .case-study-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
  }

  .case-study-preview-grid article {
    display: flex;
    min-height: 19rem;
    flex-direction: column;
    padding: 1.5rem;
  }

  .case-study-preview-grid article + article {
    border-left: 1px solid var(--color-line);
  }

  .case-number {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 1.6rem;
  }

  .case-category {
    color: var(--color-aubergine);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-study-preview-grid h3 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .case-study-preview-grid article > p:last-of-type {
    color: var(--color-muted);
  }

  .case-study-preview-grid .text-link {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .case-studies-cta {
    margin-top: 2rem;
  }

  .home-pathways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
  }

  .pathway {
    display: flex;
    flex-direction: column;
    min-height: 25rem;
    border-top: 0.55rem solid var(--color-accent);
    padding: clamp(1.75rem, 3vw, 2.75rem);
    transition: background-color 160ms ease;
  }

  .pathway + .pathway {
    border-left: 1px solid var(--color-line);
  }

  .pathway-number,
  .pathway-status {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pathway-number {
    margin-bottom: clamp(3rem, 6vw, 5rem);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .pathway:has(a):hover {
    background: var(--color-soft);
  }

  .pathway h2 {
    position: relative;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .pathway h2::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 3rem;
    height: 0.3rem;
    background: var(--color-title-accent);
    content: "";
  }

  .pathway > p:not(.pathway-number, .pathway-status) {
    color: var(--color-muted);
  }

  .pathway .text-link,
  .pathway-status {
    margin-top: auto;
    height: 4rem;
    padding-top: 2rem;
    line-height: 1.5;
  }

  .pathway-status {
    width: fit-content;
    margin-bottom: 0;
    color: var(--color-ink);
  }

  @media (max-width: 64rem) {
    .home-hero-grid {
      grid-template-rows: auto auto;
    }

    .home-heading {
      grid-column: 1 / 8;
    }

    .home-portrait {
      grid-column: 8 / 13;
    }

    .home-hero .hero-copy {
      grid-column: 1 / 8;
      padding-right: 2rem;
    }

    .areas .area-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .areas .area,
    .areas .area:nth-child(4),
    .areas .area:nth-child(5) {
      grid-column: auto;
    }

    .areas .area:nth-child(odd) {
      border-left: 0;
    }

    .areas .area:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }

    .areas .area:nth-child(even) {
      border-left: 1px solid var(--color-line);
    }

    .areas-footer {
      grid-template-columns: 1fr;
    }

    .areas-footer nav {
      justify-content: flex-start;
    }

    .home-pathways {
      grid-template-columns: 1fr 1fr;
    }

    .case-study-preview-grid {
      grid-template-columns: 1fr 1fr;
    }

    .case-study-preview-grid article:last-child {
      grid-column: 1 / -1;
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .experience-highlight {
      grid-template-columns: 1fr;
    }

    .experience-scope {
      padding-top: 2.5rem;
      padding-left: 0;
      border-top: 1px solid rgb(250 247 243 / 35%);
      border-left: 0;
    }

    .pathway:last-child {
      grid-column: 1 / -1;
      min-height: auto;
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }
  }

  @media (max-width: 46rem) {
    .home--en .areas .section-heading {
      grid-template-columns: 1fr;
    }

    .home--en .areas .section-heading h2,
    .home--en .areas .section-heading p {
      grid-column: 1;
    }

    .home-hero {
      padding-bottom: 6rem;
    }

    .home-hero-grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
    }

    .home-heading {
      order: 1;
      padding-top: 0;
    }

    .home-heading h1 {
      font-size: clamp(3.1rem, 15vw, 5rem);
    }

    .home-portrait {
      order: 2;
      width: calc(100% - 0.75rem);
      aspect-ratio: 1 / 1;
      margin-top: 0.75rem;
      margin-right: 0.75rem;
    }

    .home-portrait::before {
      inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    }

    .home-portrait img {
      object-position: 52% center;
    }

    .home-hero .hero-copy {
      order: 3;
      padding: 1.5rem 0 0;
    }

    .areas .area-list {
      grid-template-columns: 1fr;
    }

    .areas .area {
      min-height: auto;
      padding: 2rem 0;
      border-bottom: 1px solid var(--color-line);
    }

    .areas .area + .area {
      border-left: 0;
    }

    .areas .area:nth-child(n + 2) {
      border-top: 1px solid var(--color-line);
    }

    .areas .area h3 {
      margin: 2rem 0 0.75rem;
    }

    .home-pathways {
      grid-template-columns: 1fr;
    }

    .case-studies-heading,
    .case-study-preview-grid {
      grid-template-columns: 1fr;
    }

    .case-study-preview-grid article,
    .case-study-preview-grid article:last-child {
      grid-column: auto;
      min-height: 20rem;
      border-left: 0;
    }

    .case-study-preview-grid article + article {
      border-top: 1px solid var(--color-line);
    }

    .pathway,
    .pathway:last-child {
      grid-column: auto;
      min-height: 20rem;
    }

    .pathway + .pathway {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pathway {
      transition: none;
    }
  }
</style>
