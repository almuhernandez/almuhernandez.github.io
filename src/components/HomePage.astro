---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeContent, servicesContent, aboutContent, contactContent } from '../content/localized';
import type { Locale } from '../content/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const home = homeContent[locale];
const services = servicesContent[locale];
const about = aboutContent[locale];
const contact = contactContent[locale];
const en = locale === 'en';
const resourcesHref = en ? '/students/' : '/es/estudiantes/';
const contactHref = en ? '/contact/' : '/es/contacto/';
---

<BaseLayout title={en ? 'Home' : 'Inicio'} locale={locale} alternates={[{locale:'en',href:'/'},{locale:'es',href:'/es/'}]}>
  <div class="landing">
    <section id="inicio" class="landing-hero" aria-labelledby="landing-title">
      <div class="hero-copy">
        <p class="hero-kicker">{home.positioning}</p>
        <h1 id="landing-title">{en ? <>Data, context and <span class="hero-highlight">business</span> to make better decisions.</> : <>Datos, contexto y <span class="hero-highlight">negocio</span> para tomar mejores decisiones.</>}</h1>
        <p class="hero-lead">{en ? 'I help turn data and complex problems into decisions, solutions and applicable knowledge.' : 'Ayudo a transformar datos y problemas complejos en decisiones, soluciones y conocimiento aplicable.'}</p>
        <div class="hero-actions">
          <a class="hero-cta" href="#servicios">{en ? 'How I can help' : 'Descubre cómo puedo ayudarte'} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="hero-portrait"><img src="/images/profesional.jpeg" alt={en ? 'Portrait of Almu Hernández' : 'Retrato de Almu Hernández'} fetchpriority="high" /></figure>
      <div class="hero-signature" aria-hidden="true">Almu Hernández<span>✳</span></div>
    </section>
    <div class="experience-marquee" aria-label={en ? '15+ years of experience across industries and international teams' : 'Más de 15 años de experiencia en múltiples sectores y equipos internacionales'}>
      <div class="marquee-track" aria-hidden="true">
        {Array.from({length:4}).map(() => <div class="marquee-set">
          <span><strong>+15</strong> {en ? 'years of experience' : 'años de experiencia'}</span>
          <span class="marquee-star">✳</span>
          <span><strong>{en ? 'Multiple industries' : 'Múltiples sectores'}</strong> {en ? 'from retail to healthcare' : 'de retail a salud y entornos digitales'}</span>
          <span class="marquee-star">✳</span>
          <span><strong>{en ? 'International' : 'Internacional'}</strong> {en ? 'cross-country multidisciplinary teams' : 'equipos multidisciplinares en distintos países'}</span>
          <span class="marquee-star">✳</span>
        </div>)}
      </div>
    </div>

    <section id="servicios" class="landing-section services" aria-labelledby="services-title">
      <div class="section-topline"><span>01 / {en ? 'Services' : 'Servicios'}</span><span>{en ? 'What I do' : 'Qué puedo aportar'}</span></div>
      <div class="section-intro">
        <h2 id="services-title">{services.title}</h2>
        <p>{services.description}</p>
      </div>
      <div class="service-grid">
        {services.services.map((service) => <article class="service-card">
          <span class="service-number">{service.number}</span>
          <h3>{service.title}</h3>
          <p>{service.paragraphs[0]}</p>
        </article>)}
      </div>
      <a class="text-link" href={en ? '/services/' : '/es/servicios/'}>{en ? 'More about my services' : 'Conoce mis servicios'}</a>
    </section>

    <section id="sobre-mi" class="landing-section about" aria-labelledby="about-title">
      <div class="section-topline"><span>02 / {en ? 'About me' : 'Sobre mí'}</span><span>{en ? 'My background' : 'Mi trayectoria'}</span></div>
      <div class="about-grid">
        <figure><img src="/images/about.jpeg" alt={en ? 'Almu Hernández' : 'Almu Hernández'} loading="lazy" /></figure>
        <div class="about-copy">
          <h2 id="about-title">{about.title}</h2>
          {about.paragraphs.slice(0,3).map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href={en ? '/about/' : '/es/sobre-mi/'}>{en ? 'Read more about me' : 'Más sobre mí'}</a>
        </div>
      </div>
    </section>

    <section id="hablemos" class="landing-section contact" aria-labelledby="contact-title">
      <div class="section-topline"><span>03 / {en ? "Let's talk" : 'Hablemos'}</span><span>{en ? 'Get in touch' : 'Contacto'}</span></div>
      <div class="contact-grid">
        <h2 id="contact-title">{contact.headline}</h2>
        <div><p>{contact.introduction}</p><a class="text-link text-link--accent" href={contactHref}>{en ? 'Contact me' : 'Contacta conmigo'}</a></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .landing { width:100%; }
  .landing-hero { position:relative; display:grid; grid-template-columns:minmax(0,1.2fr) minmax(19rem,.8fr); align-items:center; gap:clamp(2rem,5vw,7rem); min-height:clamp(38rem,78svh,58rem); padding:clamp(3rem,7vw,8rem) clamp(0rem,2vw,2rem); overflow:hidden; }
  .hero-copy { position:relative; z-index:1; max-width:62rem; }
  .hero-kicker { font-size:.78rem; font-weight:800; text-transform:uppercase; letter-spacing:.19em; margin-bottom:clamp(1.5rem,3vw,3rem); color:var(--color-aubergine); }
  .hero-copy h1 { max-width:12ch; margin:0; font-family:var(--font-sans); font-size:clamp(3.5rem,6.2vw,7.8rem); line-height:1.02; letter-spacing:-.075em; font-weight:850; }
  .hero-highlight { background:var(--color-aubergine); color:#fff; padding:0 .12em .05em; box-decoration-break:clone; -webkit-box-decoration-break:clone; }
  .hero-lead { max-width:35rem; margin:clamp(1.6rem,3vw,3rem) 0 0; font-size:clamp(1.1rem,1.6vw,1.5rem); line-height:1.55; color:var(--color-muted); }
  .hero-actions { margin-top:clamp(1.5rem,3vw,3rem); }
  .hero-cta { display:inline-flex; align-items:center; gap:2rem; padding:1.05rem 1.5rem; color:white; background:var(--color-aubergine); font-size:.8rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; text-decoration:none; }
  .hero-cta:hover { background:var(--color-ink); }
  .hero-portrait { margin:0; position:relative; aspect-ratio:4/5; max-height:44rem; overflow:hidden; border-radius:46% 46% 4% 4%; background:#e8dce5; }
  .hero-portrait img { width:100%; height:100%; object-fit:cover; object-position:center; }
  .hero-signature { position:absolute; bottom:1.3rem; right:1rem; font-size:.9rem; font-weight:800; letter-spacing:-.02em; }
  .hero-signature span { color:var(--color-aubergine); margin-left:.4rem; }
  .experience-marquee { overflow:hidden; background:var(--color-aubergine); color:white; padding:1.25rem 0; margin:0 calc(-1 * clamp(1rem,3vw,3rem)) clamp(2rem,4vw,4rem); }
  .marquee-track { display:flex; width:max-content; animation:marquee-move 38s linear infinite; }
  .marquee-set { display:flex; align-items:center; gap:2.6rem; padding-right:2.6rem; flex:none; white-space:nowrap; font-size:.9rem; }
  .marquee-set strong { color:var(--color-accent); font-family:var(--font-display); font-size:1.4rem; font-weight:400; }
  .marquee-star { color:var(--color-accent); }
  @keyframes marquee-move { to { transform:translateX(-50%); } }
  @media(prefers-reduced-motion:reduce) { .marquee-track { animation:none; } }
  .landing-section { padding:clamp(5rem,9vw,9rem) 0; border-top:1px solid var(--color-ink); scroll-margin-top:2rem; }
  .section-topline { display:flex; justify-content:space-between; gap:1rem; margin-bottom:clamp(2.5rem,5vw,5rem); font-size:.75rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
  .section-intro { display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,6vw,6rem); align-items:end; margin-bottom:3rem; }
  .landing-section h2 { font-family:var(--font-display); font-weight:400; font-size:clamp(3rem,6vw,6rem); line-height:1; letter-spacing:-.05em; margin:0; }
  .section-intro p,.about-copy p,.contact-grid p { max-width:36rem; font-size:clamp(1.05rem,1.4vw,1.25rem); color:var(--color-muted); }
  .service-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin-bottom:2.5rem; border-block:1px solid var(--color-line); }
  .service-card { padding:2rem clamp(1rem,2.5vw,2.5rem) 3rem 0; }
  .service-card + .service-card { border-left:1px solid var(--color-line); padding-left:clamp(1rem,2.5vw,2.5rem); }
  .service-number { font-size:.8rem; color:var(--color-aubergine); }
  .service-card h3 { font-family:var(--font-display); font-size:clamp(1.8rem,2.6vw,2.8rem); font-weight:400; line-height:1.1; margin:4rem 0 1rem; }
  .service-card p { color:var(--color-muted); }
  .about-grid { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:clamp(2rem,8vw,9rem); align-items:center; }
  .about-grid figure { margin:0; aspect-ratio:4/5; overflow:hidden; }
  .about-grid img { width:100%; height:100%; object-fit:cover; }
  .about-copy h2 { margin-bottom:2rem; }
  .about-copy .text-link { margin-top:1rem; }
  .contact { padding-bottom:clamp(5rem,10vw,10rem); }
  .contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:end; }
  .contact-grid .text-link { margin-top:1.5rem; }
  @media(max-width:60rem) { .landing-hero { grid-template-columns:minmax(0,1fr) minmax(14rem,.7fr); } .hero-copy h1 { font-size:clamp(3rem,6vw,5rem); } .service-card h3 { margin-top:2rem; } }
  @media(max-width:46rem) { .landing-hero { grid-template-columns:1fr; min-height:auto; gap:2.5rem; padding:3rem 0; } .hero-copy h1 { font-size:clamp(3rem,11vw,5rem); } .hero-portrait { width:min(100%,28rem); margin-inline:auto; aspect-ratio:4/4.5; } .hero-signature { display:none; } .section-intro,.about-grid,.contact-grid { grid-template-columns:1fr; } .service-grid { grid-template-columns:1fr; } .service-card,.service-card + .service-card { border-left:0; padding:2rem 0; } .service-card + .service-card { border-top:1px solid var(--color-line); } .service-card h3 { margin-top:1rem; } .about-grid figure { max-height:30rem; } }
</style>
