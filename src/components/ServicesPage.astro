---
import BaseLayout from '../layouts/BaseLayout.astro';
import { servicesContent } from '../content/localized';
import type { Locale } from '../content/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const servicesPage = servicesContent[locale];
const localHref=(href:string)=>locale==='es'?({'/docencia/':'/es/docencia/','/proyectos/':'/es/proyectos/','/contacto/':'/es/contacto/'}[href]??href):href;
---

<BaseLayout title={servicesPage.title} description={servicesPage.description} locale={locale} alternates={[{locale:'en',href:'/services/'},{locale:'es',href:'/es/servicios/'}]}>
  <section class="hero page-hero services-hero" aria-labelledby="services-title">
    <div class="hero-grid">
      <h1 id="services-title">{servicesPage.title}</h1>
      <div class="hero-copy">
        <p class="lead">{servicesPage.introduction.lead}</p>
        <p>{servicesPage.introduction.text}</p>
      </div>
    </div>
  </section>

  <section class="service-lines" aria-label={locale==='en'?'Service lines':'Líneas de servicio'}>
    {servicesPage.services.map((service) => (
      <article class="service">
        <p class="section-number" aria-hidden="true">{service.number}</p>
        <h2>{service.title}</h2>
        <div class="service-copy">
          {service.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {'link' in service && (
          <a class="text-link" href={localHref(service.link.href)}>{service.link.label}</a>
        )}
      </article>
    ))}
  </section>

  <aside class="applied-ai" aria-labelledby="applied-ai-title">
    <p class="transversal-label">{locale==='en'?'Cross-cutting capability · Developing area':'Capacidad transversal · Área en desarrollo'}</p>
    <div>
      <h2 id="applied-ai-title">{servicesPage.appliedAI.title}</h2>
      <p>{servicesPage.appliedAI.text}</p>
    </div>
  </aside>

  <section class="deliverables" aria-labelledby="deliverables-title">
    <header class="section-intro">
      <div>
        <p class="section-label">{servicesPage.deliverables.label}</p>
        <h2 id="deliverables-title">{servicesPage.deliverables.title}</h2>
      </div>
      <p class="lead">{servicesPage.deliverables.introduction}</p>
    </header>

    <ol class="deliverable-grid">
      {servicesPage.deliverables.items.map((item, index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>

    <a class="text-link" href={localHref(servicesPage.deliverables.link.href)}>
      {servicesPage.deliverables.link.label}
    </a>
  </section>

  <section class="process" aria-labelledby="process-title">
    <header>
      <p class="section-label">{locale==='en'?'A practical way to approach problems':'Una forma práctica de abordar problemas'}</p>
      <h2 id="process-title">{servicesPage.process.title}</h2>
    </header>

    <ol class="process-list">
      {servicesPage.process.steps.map((step) => (
        <li>
          <span aria-hidden="true">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="services-cta" aria-labelledby="services-cta-title">
    <div>
      <h2 id="services-cta-title">{servicesPage.contact.title}</h2>
      <p>{servicesPage.contact.text}</p>
    </div>
    <a class="text-link text-link--accent" href={localHref(servicesPage.contact.link.href)}>
      {servicesPage.contact.link.label}
    </a>
  </section>
</BaseLayout>

<style>
  .service-lines {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(2rem, 4vw, 4rem);
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
  }

  .service {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(2rem, 3vw, 2.75rem);
  }

  .service + .service {
    border-left: 1px solid var(--color-line);
  }

  .section-number {
    display: grid;
    width: 2rem;
    height: 2rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    place-items: center;
    background: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .service h2,
  .section-intro h2,
  .process h2,
  .services-cta h2 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .service h2 {
    min-height: 2em;
    margin-bottom: 1.5rem;
    font-size: clamp(2.25rem, 3.8vw, 3.75rem);
  }

  .service-copy {
    color: var(--color-muted);
  }

  .service .text-link {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .applied-ai {
    display: grid;
    grid-template-columns: minmax(13rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 7vw, 7rem);
    margin-block: clamp(4rem, 9vw, 8rem);
    padding: clamp(2rem, 4vw, 3.5rem);
    border-left: 0.45rem solid var(--color-accent);
    background: var(--color-soft);
  }

  .transversal-label,
  .section-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .applied-ai h2 {
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .applied-ai p:last-child {
    max-width: 45rem;
    margin-bottom: 0;
  }

  .deliverables,
  .process {
    padding-block: clamp(4rem, 9vw, 8rem);
    border-top: 1px solid var(--color-ink);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(16rem, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
  }

  .section-intro h2,
  .process h2 {
    margin-bottom: 0;
    font-size: clamp(2.7rem, 5vw, 5rem);
  }

  .section-intro .lead {
    margin-bottom: 0;
  }

  .deliverable-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: clamp(3rem, 7vw, 6rem) 0 2rem;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .deliverable-grid li {
    grid-column: span 2;
    padding: 2rem clamp(1rem, 2vw, 1.75rem);
    border-bottom: 1px solid var(--color-line);
  }

  .deliverable-grid li:nth-child(4),
  .deliverable-grid li:nth-child(5) {
    grid-column: span 3;
  }

  .deliverable-grid li + li {
    border-left: 1px solid var(--color-line);
  }

  .deliverable-grid li:nth-child(4) {
    border-left: 0;
  }

  .deliverable-grid span,
  .process-list span {
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .deliverable-grid h3 {
    margin: 2.5rem 0 0.85rem;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .deliverable-grid p {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  .process {
    color: var(--color-paper);
    background: var(--color-ink);
    box-shadow: 50vw 0 0 var(--color-ink), -50vw 0 0 var(--color-ink);
  }

  .process .section-label {
    color: var(--color-accent);
  }

  .process-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .process-list li {
    position: relative;
    min-width: 0;
    padding: 1.5rem 1.25rem 0;
    border-top: 1px solid #555;
  }

  .process-list li::before {
    position: absolute;
    top: -0.4rem;
    left: 1.25rem;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--color-accent);
    border-radius: 50%;
    content: "";
  }

  .process-list li:not(:last-child)::after {
    position: absolute;
    top: -0.85rem;
    right: -0.25rem;
    color: var(--color-accent);
    content: "→";
  }

  .process-list h3 {
    margin: 1.5rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 2.15rem);
    font-weight: 400;
  }

  .process-list p {
    margin-bottom: 0;
    color: #d7d7d2;
    font-size: 0.9rem;
  }

  .services-cta {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) auto;
    gap: 3rem;
    align-items: end;
    margin-top: clamp(5rem, 10vw, 9rem);
    padding: clamp(2.5rem, 6vw, 5rem);
    background: var(--color-soft);
    border-bottom: 0.6rem solid var(--color-accent);
  }

  .services-cta h2 {
    max-width: 18ch;
    margin-bottom: 1rem;
    font-size: clamp(2.4rem, 4.5vw, 4.5rem);
  }

  .services-cta p {
    margin-bottom: 0;
    font-size: 1.05rem;
  }

  .services-cta .text-link {
    white-space: nowrap;
  }

  @media (max-width: 64rem) {
    .service-lines {
      grid-template-columns: 1fr;
    }

    .service {
      min-height: auto;
    }

    .service + .service {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .service h2 {
      min-height: auto;
    }

    .section-number {
      margin-bottom: 2rem;
    }

    .deliverable-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .deliverable-grid li,
    .deliverable-grid li:nth-child(4),
    .deliverable-grid li:nth-child(5) {
      grid-column: span 1;
    }

    .deliverable-grid li:nth-child(odd) {
      border-left: 0;
    }

    .process-list {
      grid-template-columns: 1fr;
      border-left: 1px solid #555;
    }

    .process-list li {
      padding: 0 0 2rem 2rem;
      border-top: 0;
    }

    .process-list li::before {
      top: 0.35rem;
      left: -0.4rem;
    }

    .process-list li:not(:last-child)::after {
      top: auto;
      right: auto;
      bottom: 0.55rem;
      left: -0.42rem;
      transform: rotate(90deg);
    }

    .process-list h3 {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 46rem) {
    .applied-ai,
    .section-intro,
    .services-cta {
      grid-template-columns: 1fr;
    }

    .deliverable-grid {
      grid-template-columns: 1fr;
    }

    .deliverable-grid li {
      border-left: 0;
    }

    .services-cta {
      align-items: start;
      gap: 2rem;
    }
  }
</style>
