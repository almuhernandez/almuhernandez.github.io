---
import { site } from '../content/site';
import { sharedUi } from '../content/navigation';
import type { Locale } from '../content/i18n';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const ui = sharedUi[locale];
---

<footer>
  <p>© {new Date().getFullYear()} {site.name}</p>
  <nav aria-label={ui.legalLabel}>
    <a href="/aviso-legal/" hreflang="es" title={locale === 'en' ? ui.spanishOnly : undefined}>{ui.legalNotice}{locale === 'en' && <span class="nav-language"> ES</span>}</a>
    <a href="/privacidad/" hreflang="es" title={locale === 'en' ? ui.spanishOnly : undefined}>{ui.privacy}{locale === 'en' && <span class="nav-language"> ES</span>}</a>
  </nav>
</footer>
