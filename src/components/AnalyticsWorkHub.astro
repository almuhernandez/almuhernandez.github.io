---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { analyticsWorkPaths, caseStudyPath, type Locale } from '../content/i18n';
import { caseStudies, hubCopy, industryOptions, portfolioProjects, problemOptions, professionalWork } from '../content/projects';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = hubCopy[locale];
const primaryProject = portfolioProjects[0];
const secondaryProjects = portfolioProjects.slice(1);
const relatedLabel = locale === 'es' ? 'Case studies relacionados' : 'Related case studies';
const visualPending = locale === 'es' ? 'Visual del proyecto en preparación' : 'Project visual in preparation';
---
<BaseLayout title={copy.pageTitle} description={copy.metaDescription} locale={locale} alternates={[{locale:'es',href:analyticsWorkPaths.es},{locale:'en',href:analyticsWorkPaths.en}]}>
  <LanguageSwitcher locale={locale} esHref={analyticsWorkPaths.es} enHref={analyticsWorkPaths.en} label={copy.switchLabel}/>
  <section class="work-hero" aria-labelledby="work-title"><p class="eyebrow">{copy.eyebrow}</p><div class="work-hero-grid"><h1 id="work-title">{copy.title}</h1><div><p class="lead">{copy.introduction}</p><p class="industry-line">{copy.industries}</p></div></div></section>

  <section class="work-section" aria-labelledby="professional-title">
    <header class="work-heading"><p class="section-number" aria-hidden="true">{copy.professional.number}</p><div><p class="section-label">{copy.professional.label}</p><h2 id="professional-title">{copy.professional.title}</h2></div><p>{copy.professional.introduction}</p></header>
    <div class="professional-list">{professionalWork.map(work=><article class="professional-item"><div><h3>{work.title[locale]}</h3><p class="company">{work.company}{work.engagement&&<span> · {work.engagement[locale]}</span>}</p><p class="context">{work.domain[locale]}</p></div><div><p>{work.description[locale]}</p><ul class="tag-list" aria-label={locale==='es'?'Temas':'Themes'}>{work.tags[locale].map(tag=><li>{tag}</li>)}</ul>{work.related.length>0&&<div class="professional-related"><p>{relatedLabel}</p><div>{work.related.map(slug=>{const item=caseStudies.find(caseStudy=>caseStudy.slug===slug);return item&&<a href={caseStudyPath(locale,item.slug)}>{item.title[locale]}<span aria-hidden="true">↗</span></a>})}</div></div>}</div></article>)}</div>
  </section>

  <section class="work-section case-library" aria-labelledby="library-title" data-case-library>
    <header class="work-heading work-heading--dark"><p class="section-number" aria-hidden="true">{copy.library.number}</p><div><h2 id="library-title">{copy.library.title}</h2></div><p>{copy.library.introduction}</p></header>
    <form class="case-filters" data-case-filters><div class="filter-field filter-search"><label for={`case-search-${locale}`}>{copy.library.searchLabel}</label><input id={`case-search-${locale}`} type="search" placeholder={copy.library.searchPlaceholder} data-case-search/></div><div class="filter-field"><label for={`industry-filter-${locale}`}>{copy.library.industryLabel}</label><select id={`industry-filter-${locale}`} data-industry-filter><option value="">{copy.library.allIndustries}</option>{industryOptions.map(option=><option value={option.value}>{option[locale]}</option>)}</select></div><div class="filter-field"><label for={`problem-filter-${locale}`}>{copy.library.problemLabel}</label><select id={`problem-filter-${locale}`} data-problem-filter><option value="">{copy.library.allProblems}</option>{problemOptions.map(option=><option value={option.value}>{option[locale]}</option>)}</select></div></form>
    <p class="results-status" aria-live="polite"><strong data-result-count>{caseStudies.length}</strong> {copy.library.results}</p>
    <div class="case-grid">{caseStudies.map((item,index)=><article class="case-card" data-case-card data-industries={item.industries.join(' ')} data-problems={item.problems.join(' ')} data-search={`${item.title[locale]} ${item.question[locale]} ${item.industryLabels[locale].join(' ')} ${item.tags[locale].join(' ')}`.toLocaleLowerCase(locale)}><div class="case-visual" aria-hidden="true"><span>{String(index+1).padStart(2,'0')}</span></div><p class="case-category">{item.category[locale]}</p><h3>{item.title[locale]}</h3><p>{item.question[locale]}</p><p class="case-meta"><strong>{copy.library.industryLabel}:</strong> {item.industryLabels[locale].join(' · ')}</p><ul class="tag-list" aria-label={locale==='es'?'Enfoques analíticos':'Analytical approaches'}>{item.tags[locale].map(tag=><li>{tag}</li>)}</ul><a class="case-link" href={caseStudyPath(locale,item.slug)}>{copy.library.explore}<span aria-hidden="true">↗</span></a></article>)}</div><p class="no-results" data-no-results hidden>{copy.library.noResults}</p>
  </section>

  <section class="work-section portfolio-work" aria-labelledby="portfolio-title">
    <header class="work-heading"><p class="section-number" aria-hidden="true">{copy.portfolio.number}</p><div><h2 id="portfolio-title">{copy.portfolio.title}</h2></div><p>{copy.portfolio.introduction}</p></header>
    <article class="portfolio-primary"><div class="project-visual"><span>{visualPending}</span></div><div><p class="project-label">{primaryProject.label[locale]}</p><p class="context">{primaryProject.meta[locale]}</p><h3>{primaryProject.title}</h3><p>{primaryProject.description[locale]}</p><ul class="tag-list" aria-label={locale==='es'?'Temas':'Themes'}>{primaryProject.tags[locale].map(tag=><li>{tag}</li>)}</ul></div></article>
    {secondaryProjects.map(project=><aside class="portfolio-secondary"><div><p class="project-label">{project.label[locale]}</p><h3>{project.title}</h3></div><div><p>{project.description[locale]}</p><p class="context">{project.meta[locale]}</p>{project.link&&<a class="text-link text-link--accent" href={project.link.url} target="_blank" rel="noopener noreferrer">{project.link.label[locale]}</a>}</div></aside>)}
  </section>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLElement>('[data-case-library]').forEach(library=>{const search=library.querySelector<HTMLInputElement>('[data-case-search]');const industry=library.querySelector<HTMLSelectElement>('[data-industry-filter]');const problem=library.querySelector<HTMLSelectElement>('[data-problem-filter]');const cards=[...library.querySelectorAll<HTMLElement>('[data-case-card]')];const count=library.querySelector<HTMLElement>('[data-result-count]');const empty=library.querySelector<HTMLElement>('[data-no-results]');const applyFilters=()=>{const term=search?.value.trim().toLocaleLowerCase()??'';let visible=0;cards.forEach(card=>{const matches=(!term||card.dataset.search?.includes(term))&&(!industry?.value||card.dataset.industries?.split(' ').includes(industry.value))&&(!problem?.value||card.dataset.problems?.split(' ').includes(problem.value));card.hidden=!matches;if(matches)visible+=1});if(count)count.textContent=String(visible);if(empty)empty.hidden=visible!==0};search?.addEventListener('input',applyFilters);industry?.addEventListener('change',applyFilters);problem?.addEventListener('change',applyFilters)});
</script>
<style>
  .work-hero{padding:1rem 0 clamp(4rem,8vw,7rem)}.work-hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(20rem,.85fr);gap:clamp(2.5rem,7vw,7rem);align-items:end}.work-hero h1{max-width:11ch;font-size:clamp(3.2rem,6.5vw,6.2rem)}.industry-line{margin-top:2rem;padding-top:1rem;border-top:.35rem solid var(--color-aubergine);color:var(--color-muted);font-size:.85rem;font-weight:700}.work-section{padding-block:clamp(4rem,8vw,7rem);border-top:1px solid var(--color-ink)}.work-heading{display:grid;grid-template-columns:3rem minmax(16rem,1fr) minmax(20rem,.9fr);gap:clamp(1rem,4vw,4rem);align-items:start;margin-bottom:clamp(3rem,6vw,5rem)}.section-number{display:grid;width:2rem;height:2rem;place-items:center;background:var(--color-accent);font-size:.72rem;font-weight:700}.section-label,.project-label,.case-category{font-size:.7rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.section-label,.project-label{color:var(--color-aubergine)}.work-heading h2{margin:0;font-family:var(--font-display);font-size:clamp(2.4rem,4.5vw,4.5rem);font-weight:400;letter-spacing:-.045em;line-height:1}.work-heading>p:last-child{max-width:38rem;color:var(--color-muted)}
  .professional-list{border-top:1px solid var(--color-line)}.professional-item{display:grid;grid-template-columns:minmax(16rem,.8fr) minmax(20rem,1.2fr);gap:clamp(2rem,6vw,6rem);padding-block:2.5rem;border-bottom:1px solid var(--color-line)}.professional-item h3{margin-bottom:.8rem;font-family:var(--font-display);font-size:clamp(1.5rem,2.5vw,2.2rem);font-weight:400;line-height:1.1}.company{margin-bottom:.15rem;font-weight:700}.context,.case-meta{color:var(--color-muted);font-size:.85rem}.tag-list{display:flex;flex-wrap:wrap;gap:.5rem .8rem;margin:1.25rem 0 0;padding:0;list-style:none}.tag-list li{padding-bottom:.12rem;border-bottom:.2rem solid var(--color-accent);font-size:.78rem;font-weight:700}.professional-related{margin-top:1.5rem}.professional-related>p{margin-bottom:.35rem;color:var(--color-muted);font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.professional-related>div{display:flex;flex-wrap:wrap;gap:.5rem 1.25rem}.professional-related a{font-size:.78rem;font-weight:700;text-decoration-color:var(--color-accent)}.professional-related a span{margin-left:.35rem}
  .portfolio-primary{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(18rem,.85fr);gap:clamp(2rem,6vw,6rem);padding:clamp(1.5rem,4vw,3.5rem);border:1px solid var(--color-ink)}.project-visual{display:grid;min-height:22rem;place-items:center;padding:2rem;border:.25rem dashed var(--color-line);color:var(--color-muted);background:var(--color-surface);text-align:center}.project-visual span{max-width:18rem;font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.portfolio-primary>div:last-child{align-self:center}.portfolio-primary h3{font-family:var(--font-display);font-size:clamp(2.6rem,5vw,4.8rem);font-weight:400;letter-spacing:-.04em;line-height:1}.portfolio-secondary{display:grid;grid-template-columns:minmax(14rem,.7fr) minmax(20rem,1.3fr);gap:clamp(2rem,6vw,6rem);margin-top:1.5rem;padding:clamp(1.5rem,3vw,2.5rem);border-top:.4rem solid var(--color-aubergine);background:var(--color-surface)}.portfolio-secondary h3{font-family:var(--font-display);font-size:clamp(2rem,3vw,3rem);font-weight:400}.portfolio-secondary .text-link{margin-top:1.5rem}
  .case-library{color:var(--color-paper);background:var(--color-aubergine);box-shadow:50vw 0 0 var(--color-aubergine),-50vw 0 0 var(--color-aubergine)}.work-heading--dark>p:last-child{color:#e1d7de}.case-filters{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:1rem;margin-bottom:1rem;padding:1.25rem;color:var(--color-ink);background:var(--color-paper)}.filter-field{display:grid;gap:.45rem}.filter-field label{font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.filter-field input,.filter-field select{width:100%;min-height:3rem;padding:.65rem .75rem;border:1px solid var(--color-ink);border-radius:0;color:var(--color-ink);background:var(--color-surface);font:inherit}.filter-field input:focus-visible,.filter-field select:focus-visible{outline:3px solid var(--color-aubergine);outline-offset:2px}.results-status{color:#e1d7de;font-size:.85rem}.case-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:#78436a}.case-card{display:flex;min-height:34rem;flex-direction:column;padding:clamp(1.5rem,3vw,2.5rem);color:var(--color-ink);background:var(--color-paper)}.case-card[hidden]{display:none}.case-visual{display:flex;height:5rem;align-items:flex-start;justify-content:flex-end;margin-bottom:2rem;border-top:.45rem solid var(--color-accent);color:var(--color-aubergine);font-family:var(--font-display);font-size:2.5rem}.case-card h3{font-family:var(--font-display);font-size:clamp(2rem,3.5vw,3.1rem);font-weight:400;letter-spacing:-.04em;line-height:1}.evidence-marker{margin-top:1.25rem;padding-left:.8rem;border-left:.3rem solid var(--color-accent);color:var(--color-aubergine);font-size:.78rem;font-weight:700}.case-link{display:flex;align-items:center;justify-content:space-between;min-height:3rem;margin-top:auto;padding-top:1rem;border-top:1px solid var(--color-ink);font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-decoration:none}.case-link:hover{border-color:var(--color-accent);color:var(--color-aubergine)}.no-results{padding:2rem;color:var(--color-ink);background:var(--color-paper)}
  .professional-list{border-top-color:var(--color-ink)}.professional-item{padding:clamp(2rem,4vw,3.25rem);background:var(--color-paper);transition:background-color .2s ease,border-color .2s ease}.professional-item:nth-child(even){background:var(--color-surface)}.professional-item:hover{border-left:.3rem solid var(--color-aubergine);background:#fff}.professional-item h3{color:var(--color-aubergine);font-size:clamp(1.65rem,2.7vw,2.35rem)}.professional-item .context{color:var(--color-aubergine);font-size:.72rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.professional-related{padding-top:1rem;border-top:1px solid var(--color-line)}.professional-related a{text-decoration-thickness:.2rem;text-underline-offset:.25rem}.portfolio-work{border-top:0}
  .company span{color:var(--color-muted);font-weight:400}
  @media(max-width:62rem){.work-hero-grid{grid-template-columns:1fr}.work-heading{grid-template-columns:3rem 1fr}.work-heading>p:last-child{grid-column:2}.professional-item,.portfolio-primary,.portfolio-secondary{grid-template-columns:1fr}.case-filters{grid-template-columns:1fr 1fr}.filter-search{grid-column:1/-1}}@media(max-width:46rem){.work-heading{grid-template-columns:2rem 1fr;gap:1rem}.professional-item,.case-grid,.case-filters{grid-template-columns:1fr}.filter-search{grid-column:auto}.project-visual{min-height:14rem}.case-card{min-height:0}}
</style>
