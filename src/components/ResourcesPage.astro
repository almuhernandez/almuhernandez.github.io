---
import BaseLayout from '../layouts/BaseLayout.astro';
import type {Locale} from '../content/i18n';
interface Props {locale:Locale; variant?:'resources'|'consulting'}
const {locale,variant='resources'}=Astro.props; const en=locale==='en'; const consulting=variant==='consulting';
const cases=[
{slug:'customer-segmentation',title:['Segmentación de clientes','Customer segmentation'],subtitle:['Segmentos, perfiles y oportunidades','Segments, profiles and opportunities'],cat:'customer',label:'CUSTOMER ANALYTICS',art:'seg'},
{slug:'market-basket-analysis',title:['Análisis de cesta de compra','Market basket analysis'],subtitle:['Afinidad de productos y patrones de compra','Product affinity and shopping patterns'],cat:'retail',label:'RETAIL · ANALYTICS',art:'basket'},
{slug:'customer-churn-retention',title:['Abandono y retención','Churn and retention'],subtitle:['Identificar señales de abandono','Identify churn signals'],cat:'customer',label:'CUSTOMER ANALYTICS',art:'churn'},
{slug:'propensity-modelling',title:['Modelos de propensión','Propensity modelling'],subtitle:['Priorizar acciones con modelos predictivos','Prioritize actions with predictive models'],cat:'predictive',label:'PREDICTIVE ANALYTICS',art:'model'},
{slug:'customer-lifetime-value',title:['Valor del cliente · CLV','Customer lifetime value · CLV'],subtitle:['Entender el valor a largo plazo','Understand long-term value'],cat:'customer',label:'ESTRATEGIA · DATOS',art:'clv'},
{slug:'marketing-campaign-effectiveness',title:['Efectividad de campañas','Campaign effectiveness'],subtitle:['Medir impacto y resultados','Measure impact and outcomes'],cat:'retail',label:'MARKETING ANALYTICS',art:'campaign'},
{slug:'product-feature-adoption',title:['Adopción de producto','Product adoption'],subtitle:['Comprender el uso de funcionalidades','Understand feature usage'],cat:'product',label:'PRODUCT ANALYTICS',art:'adoption'},
{slug:'sales-funnel-conversion',title:['Embudo de conversión','Sales funnel conversion'],subtitle:['Detectar fricciones en el recorrido','Find friction in the funnel'],cat:'product',label:'PRODUCT ANALYTICS',art:'funnel'},
{slug:'pricing-revenue-analysis',title:['Precios e ingresos','Pricing and revenue'],subtitle:['Explorar decisiones de precio','Explore pricing decisions'],cat:'retail',label:'ESTRATEGIA · DATOS',art:'pricing'},
{slug:'demand-sales-forecasting',title:['Previsión de demanda','Demand forecasting'],subtitle:['Anticipar tendencias y necesidades','Anticipate trends and demand'],cat:'predictive',label:'PREDICTIVE ANALYTICS',art:'forecast'}
];
const filters=en?[['all','All'],['customer','Customers'],['retail','Marketing & retail'],['product','Business & product'],['predictive','Predictive models']]:[['all','Todos'],['customer','Clientes'],['retail','Marketing y retail'],['product','Negocio y producto'],['predictive','Modelos predictivos']];
const pdfs:Record<string,string>={
'customer-segmentation':'/case-studies/customer-segmentation-case-study.pdf',
'market-basket-analysis':'/case-studies/market_basket_analysis_case_study_v1_2pages.pdf',
'customer-churn-retention':'/case-studies/03_customer_churn_retention.pdf',
'propensity-modelling':'/case-studies/04_propensity_modelling.pdf',
'customer-lifetime-value':'/case-studies/05_customer_lifetime_value.pdf',
'marketing-campaign-effectiveness':'/case-studies/06_marketing_campaign_effectiveness.pdf',
'product-feature-adoption':'/case-studies/07_product_feature_adoption.pdf',
'sales-funnel-conversion':'/case-studies/08_sales_funnel_conversion.pdf',
'pricing-revenue-analysis':'/case-studies/09_pricing_revenue_analysis.pdf',
'demand-sales-forecasting':'/case-studies/10_demand_sales_forecasting.pdf'
};
---
<BaseLayout title={consulting?(en?'Case studies':'Casos de uso'):(en?'Resources':'Recursos')} locale={locale} alternates={consulting?[{locale:'es',href:'/es/consultoria/casos-de-uso/'},{locale:'en',href:'/consulting/case-studies/'}]:[{locale:'es',href:'/es/recursos/'},{locale:'en',href:'/resources/'}]}>
<div class:list={["resource-page",{"consulting-cases-page":consulting}]}>
<section class="resource-intro" id="recursos"><h1>{consulting?(en?'Case studies':'Casos de uso'):(en?'Resources':'Recursos')}</h1><p>{consulting?(en?'A selection of practical examples of how data and analytics can help address real challenges.': 'Algunos ejemplos prácticos de cómo los datos y la analítica pueden ayudar a resolver problemas reales.'):(en?<>Ideas, case studies and tools to connect <strong>data, AI and business.</strong> A library of practical projects to explore real problems and learn how to solve them.</>:<>Ideas, casos y herramientas para conectar <strong>datos, IA y negocio.</strong> Una biblioteca de proyectos prácticos para explorar problemas reales y aprender a resolverlos.</>)}</p></section>
<div class="resource-filters" role="group" aria-label={en?'Filter cases':'Filtrar casos'}>{filters.map(([id,label],i)=><button type="button" data-filter={id} class:list={{active:i===0}} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div>
<section class="resource-grid" aria-label={en?'Business analytics case studies':'Casos de Business Analytics'}>{cases.map((item,i)=><article class="resource-card" data-category={item.cat}><div class:list={['resource-art','art-'+item.art]} aria-hidden="true"><div class="resource-illustration">
{item.art==='seg'&&<div class="ill-circles">{Array.from({length:7}).map(()=> <i></i>)}</div>}
{item.art==='basket'&&<div class="ill-matrix">{Array.from({length:48}).map((_,j)=><i style={{opacity:String(.2+((j*7)%8)/10)}}></i>)}</div>}
{(item.art==='churn'||item.art==='forecast')&&<svg class="ill-line" viewBox="0 0 300 140" aria-hidden="true"><polyline fill="none" points={item.art==='churn'?'0,28 45,39 85,30 120,61 165,54 205,89 245,99 300,130':'0,118 45,98 85,106 120,64 165,78 205,40 245,48 300,12'} stroke="currentColor" stroke-width="7"/></svg>}
{item.art==='model'&&<div class="ill-bars">{[25,41,36,64,55,83,69,94].map(v=><i style={{height:v+'%'}}></i>)}</div>}
{item.art==='clv'&&<div class="ill-number">€<span>∞</span></div>}
{item.art==='campaign'&&<div class="ill-donut"></div>}
{item.art==='adoption'&&<div class="ill-steps">{[50,80,120,160].map(v=><i style={{height:v+'px'}}></i>)}</div>}
{item.art==='funnel'&&<div class="ill-funnel">{[240,185,130,75].map(v=><i style={{width:v+'px'}}></i>)}</div>}
{item.art==='pricing'&&<div class="ill-number">↗<span>€</span></div>}
</div><span class="art-caption">{item.subtitle[en?1:0]}</span></div><h2>{item.title[en?1:0]}</h2><p class="resource-category">{item.label}</p><p class="resource-subtitle">{item.subtitle[en?1:0]}</p><a class="resource-download" href={pdfs[item.slug]} target="_blank" rel="noopener noreferrer" aria-label={(en?'Download PDF: ':'Descargar PDF: ')+item.title[en?1:0]}>{en?'Download PDF':'Descargar PDF'} ↗</a></article>)}</section>
{consulting?<section class="resource-contact"><div><h2>{en?"Can't find what you're looking for?":'¿No encuentras lo que buscas?'}</h2><p>{en?"These are just a few examples, but we can talk if what you need isn't in this catalogue.":'Estos son solo algunos ejemplos, pero podemos hablar si lo que necesitas no está en este catálogo.'}</p></div><a href={en?'/#hablemos':'/es/#hablemos'}>{en?"Let's talk":'Hablemos'} ↗</a></section>:null}
</div>
</BaseLayout>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>('.resource-filters button');const cards=document.querySelectorAll<HTMLElement>('.resource-card');buttons.forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter;buttons.forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});cards.forEach(card=>{card.hidden=filter!=='all'&&card.dataset.category!==filter})}));
</script>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');
.resource-page{background:#f8f6f3;color:#242124;font-family:'DM Sans',Arial,sans-serif;padding-bottom:100px}.resource-intro{text-align:center;padding:clamp(65px,9vw,130px) 25px 55px;overflow:hidden}.resource-intro h1{max-width:none;white-space:nowrap;font:italic 400 clamp(88px,17vw,280px)/1.12 'Playfair Display',Georgia,serif;letter-spacing:-.075em;color:#e8dfd6;margin:0 0 20px}.resource-intro p{font-size:clamp(16px,1.3vw,19px);max-width:850px;line-height:1.8;margin:0 auto}.resource-intro strong{color:#4b123b}.resource-filters{display:flex;justify-content:center;flex-wrap:wrap;gap:15px 32px;padding:0 20px;margin:20px auto 75px}.resource-filters button{border:0;background:none;color:#242124;font:700 12px 'DM Sans',sans-serif;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;padding:10px 0}.resource-filters button.active,.resource-filters button:hover{color:#4b123b;border-bottom:2px solid #4b123b}.resource-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:65px 22px;max-width:1400px;margin:auto;padding:0 clamp(18px,3vw,50px)}.resource-card{text-decoration:none;text-align:center;display:block;color:inherit}.resource-card[hidden]{display:none}.resource-art{aspect-ratio:1.45;position:relative;overflow:hidden;background:#dcd5d1;display:flex;justify-content:center;align-items:center}.art-seg{background:#e8ddd5}.art-basket{background:#d7d0e4}.art-churn{background:#cdd7d6}.art-model{background:#ddd4c9}.art-clv{background:#e1d8dc}.art-campaign{background:#cdd8e0}.art-adoption{background:#d9d4c7}.art-funnel{background:#d8cbd2}.art-pricing{background:#d9d6c9}.art-forecast{background:#d0d8d5}.art-orbit{width:54%;aspect-ratio:1;border:22px solid #4b123b;border-radius:50%;opacity:.65;transform:rotate(-20deg) scaleX(1.3);transition:transform .35s}.resource-card:hover .art-orbit{transform:rotate(15deg) scaleX(1.3)}.art-bars{position:absolute;display:flex;gap:9px;align-items:end;height:45%;bottom:15%;left:18%;opacity:.8}.art-bars i{width:14px;background:#e9c75f;height:45%}.art-bars i:nth-child(2){height:80%}.art-bars i:nth-child(3){height:60%}.art-bars i:nth-child(4){height:100%}.art-bars i:nth-child(5){height:72%}.art-label{position:absolute;top:16px;left:18px;font-size:10px;letter-spacing:.12em;color:#4b123b;font-weight:700}.resource-card h2{font:italic 400 clamp(24px,2vw,34px)/1.3 'Playfair Display',Georgia,serif;margin:22px 0 10px}.resource-category{font-size:11px;letter-spacing:.14em;color:#a06b75;text-transform:uppercase;font-weight:700;margin:0}.resource-subtitle{font-size:13px;color:#686065;margin:8px 0}.resource-learning{text-align:center;max-width:800px;margin:110px auto 0;padding:0 25px}.resource-learning h2{font:400 clamp(40px,5vw,65px) 'Playfair Display',Georgia,serif}.resource-learning p{line-height:1.7}.resource-learning a{display:inline-block;margin-top:22px;background:#4b123b;color:white;text-decoration:none;padding:15px 22px;font-size:12px;text-transform:uppercase;letter-spacing:.1em}.resource-learning a:hover{background:#e9c75f;color:#242124}@media(max-width:900px){.resource-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:580px){.resource-grid{grid-template-columns:1fr;gap:50px}.resource-intro h1{font-size:clamp(65px,17vw,100px)}}

/* Consistent with the homepage typography and four-color palette. */
.resource-page{background:#f1e8de;color:#171717}
.resource-intro{padding:clamp(75px,9vw,125px) 25px 50px}
.resource-intro h1{font:normal 400 clamp(58px,7vw,110px)/1.06 'Playfair Display',Georgia,serif;letter-spacing:-.055em;color:#4b123b;white-space:normal;margin-bottom:30px}
.resource-intro p{font-size:clamp(17px,1.45vw,21px);line-height:1.65;max-width:780px}
.resource-filters{margin:28px auto 64px}
.resource-grid{gap:65px 24px}
.resource-card{min-width:0}
.resource-card h2{font:normal 400 clamp(27px,2.35vw,37px)/1.25 'Playfair Display',Georgia,serif;letter-spacing:-.035em}
.resource-art{aspect-ratio:1.45}
.resource-card:nth-child(4n + 1) .resource-art{background:#171717;color:#fff}
.resource-card:nth-child(4n + 2) .resource-art{background:#4b123b;color:#fff}
.resource-card:nth-child(4n + 3) .resource-art{background:#e9c75f;color:#171717}
.resource-card:nth-child(4n + 4) .resource-art{background:#f1e8de;color:#4b123b;border:1px solid #d9cbc2}
.resource-card:nth-child(4n + 1) .art-orbit,.resource-card:nth-child(4n + 2) .art-orbit{border-color:#e9c75f}
.resource-card:nth-child(4n + 3) .art-orbit,.resource-card:nth-child(4n + 4) .art-orbit{border-color:#4b123b}
.resource-card:nth-child(4n + 1) .art-label,.resource-card:nth-child(4n + 2) .art-label{color:#e9c75f}
.resource-card:nth-child(4n + 3) .art-label,.resource-card:nth-child(4n + 4) .art-label{color:#4b123b}
.resource-card:nth-child(4n + 3) .art-bars i,.resource-card:nth-child(4n + 4) .art-bars i{background:#4b123b}
.resource-category{color:#4b123b}
.resource-download{display:inline-block;margin-top:18px;padding:14px 19px;background:#4b123b;color:#fff;text-decoration:none;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
.resource-download:hover{background:#e9c75f;color:#171717}
.resource-contact{display:flex;align-items:center;justify-content:space-between;gap:45px;margin-top:105px;padding:clamp(90px,10vw,145px) clamp(30px,9vw,145px);background:#4b123b;color:#fff}
.resource-contact h2{font:normal 400 clamp(42px,4.5vw,70px)/1.12 'Playfair Display',Georgia,serif;letter-spacing:-.05em;margin:0 0 14px}
.resource-contact p{font-size:clamp(16px,1.35vw,19px);line-height:1.6;max-width:700px;margin:0}
.resource-contact>a{flex:none;display:inline-block;padding:18px 28px;background:#e9c75f;color:#171717;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
.resource-contact>a:hover{background:#fff}
@media(max-width:700px){.resource-contact{flex-direction:column;align-items:flex-start;padding:75px 25px}.resource-intro h1{font-size:clamp(56px,13vw,78px)}}

/* Distinct illustrations from the approved case-study preview. */
.resource-art{display:grid;place-items:center}
.resource-illustration{position:absolute;inset:13%;display:grid;place-items:center;opacity:.82;color:inherit}
.art-caption{position:absolute;bottom:18px;left:22px;right:22px;max-width:75%;text-align:left;font:400 clamp(17px,1.6vw,24px)/1.15 'Playfair Display',Georgia,serif}
.ill-circles{display:flex;flex-wrap:wrap;width:min(220px,85%);gap:12px;justify-content:center}.ill-circles i{width:52px;height:52px;max-width:25%;aspect-ratio:1;border-radius:50%;background:currentColor}.ill-circles i:nth-child(even){opacity:.28}
.ill-matrix{display:grid;grid-template-columns:repeat(8,1fr);gap:5px;width:min(220px,85%)}.ill-matrix i{background:currentColor;aspect-ratio:1}
.ill-line{width:min(300px,95%);overflow:visible}
.ill-bars{display:flex;align-items:end;gap:9px;width:70%;height:150px}.ill-bars i{background:currentColor;flex:1}
.ill-number{font-family:Georgia,serif;font-size:clamp(70px,8vw,120px);line-height:1}.ill-number span{font-size:.6em}
.ill-donut{width:165px;height:165px;border:35px solid currentColor;border-right-color:transparent;border-radius:50%;transform:rotate(30deg)}
.ill-steps{display:flex;gap:10px;align-items:end}.ill-steps i{width:45px;max-width:20%;background:currentColor}
.ill-funnel{display:grid;justify-items:center;gap:8px}.ill-funnel i{height:28px;background:currentColor;max-width:100%}
.resource-card:nth-child(4n + 1) .resource-art,.resource-card:nth-child(4n + 2) .resource-art{color:#e9c75f}
.resource-card:nth-child(4n + 3) .resource-art,.resource-card:nth-child(4n + 4) .resource-art{color:#4b123b}
@media(max-width:580px){.ill-circles i{width:40px;height:40px}.ill-steps i{width:30px}}

/* Larger editorial italic headings on both library pages. */
.resource-intro h1{font:italic 400 clamp(88px,12vw,190px)/1.08 'Playfair Display',Georgia,serif;letter-spacing:-.07em;color:#4b123b;white-space:normal}
@media(max-width:700px){.resource-intro h1{font-size:clamp(67px,14vw,110px)}}
/* Consulting cases explicitly inherit the visual library treatment. */
.consulting-cases-page .resource-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:65px 24px;max-width:1400px;margin-inline:auto}
.consulting-cases-page .resource-card{display:block;text-align:center;min-width:0}
.consulting-cases-page .resource-card[hidden]{display:none}
.consulting-cases-page .resource-art{position:relative;display:grid;place-items:center;aspect-ratio:1.45;overflow:hidden}
.consulting-cases-page .resource-card:nth-child(4n + 1) .resource-art{background:#171717;color:#e9c75f}
.consulting-cases-page .resource-card:nth-child(4n + 2) .resource-art{background:#4b123b;color:#e9c75f}
.consulting-cases-page .resource-card:nth-child(4n + 3) .resource-art{background:#e9c75f;color:#4b123b}
.consulting-cases-page .resource-card:nth-child(4n + 4) .resource-art{background:#f1e8de;color:#4b123b;border:1px solid #d9cbc2}
.consulting-cases-page .resource-illustration{position:absolute;inset:13%;display:grid;place-items:center;color:inherit}
@media(max-width:900px){.consulting-cases-page .resource-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:580px){.consulting-cases-page .resource-grid{grid-template-columns:1fr}}

/* Keep the longer consulting title inside the viewport on all screen sizes. */
.consulting-cases-page .resource-intro{min-width:0;max-width:100%;box-sizing:border-box;overflow:hidden}
.consulting-cases-page .resource-intro h1{font-size:clamp(48px,8.5vw,132px);line-height:1.12;letter-spacing:-.055em;max-width:100%;overflow-wrap:normal}
.consulting-cases-page .resource-grid{width:100%;box-sizing:border-box}
.consulting-cases-page .resource-card,.consulting-cases-page .resource-art{box-sizing:border-box;max-width:100%}
@media(max-width:700px){.consulting-cases-page .resource-intro h1{font-size:clamp(44px,10vw,75px)}}
</style>