---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { analyticsWorkPaths, caseStudyPath, type Locale } from '../content/i18n';
import { caseStudies, caseStudyBusinessContent, type CaseStudy } from '../content/projects';
interface Props { locale: Locale; caseStudy: CaseStudy }
const { locale, caseStudy } = Astro.props;
const businessContent = caseStudyBusinessContent[caseStudy.slug];
const related = caseStudy.related.map(slug=>caseStudies.find(item=>item.slug===slug)).filter((item):item is CaseStudy=>Boolean(item));
const ui = locale === 'es' ? {
  back:'Todos los proyectos', label:'Caso práctico', challenge:'El reto de negocio', questions:'Preguntas clave de negocio', evidence:'Datos y evidencia', approach:'Cómo lo abordaría', outputs:'Qué recibirías', action:'Del análisis a la acción', illustrative:'Ejemplo ilustrativo', measurement:'Cómo medir el éxito', alternatives:'Otros enfoques a considerar', industries:'Industrias relevantes', related:'Casos prácticos relacionados', explore:'Explorar caso práctico', pdf:'Descargar PDF', pdfNote:'Recurso visual complementario para profundizar en el caso.', contactTitle:'¿Trabajas en un reto analítico similar?', contact:'Hablemos', switchLabel:'Idioma', approaches:'Enfoques'
} : {
  back:'All projects', label:'Case Study', challenge:'The business challenge', questions:'Key business questions', evidence:'Data & evidence', approach:'How I would approach it', outputs:'What you would get', action:'From analysis to action', illustrative:'Illustrative example', measurement:'How success should be measured', alternatives:'Other approaches to consider', industries:'Relevant industries', related:'Related case studies', explore:'Explore case study', pdf:'Download PDF', pdfNote:'A complementary visual resource for a deeper view of the case.', contactTitle:'Working on a similar analytics challenge?', contact:"Let's talk", switchLabel:'Language', approaches:'Approaches'
};
const esHref=caseStudyPath('es',caseStudy.slug); const enHref=caseStudyPath('en',caseStudy.slug);
---
<BaseLayout title={caseStudy.title[locale]} description={caseStudy.metaDescription[locale]} locale={locale} alternates={[{locale:'es',href:esHref},{locale:'en',href:enHref}]}>
  <LanguageSwitcher locale={locale} esHref={esHref} enHref={enHref} label={ui.switchLabel}/>
  <article class="case-detail">
    <header class="case-hero"><a class="back-link" href={analyticsWorkPaths[locale]}>← {ui.back}</a><p class="eyebrow">{ui.label}</p><div class="case-hero-grid"><div><p class="case-category">{caseStudy.category[locale]}</p><h1>{caseStudy.title[locale]}</h1></div><div><p class="lead">{caseStudy.question[locale]}</p>{caseStudy.pdfPath&&<div class="pdf-resource"><a class="text-link text-link--accent" href={caseStudy.pdfPath}>{ui.pdf}</a><p>{ui.pdfNote}</p></div>}</div></div></header>
    <div class="case-meta-band"><div><p>{ui.industries}</p><ul>{caseStudy.industryLabels[locale].map(item=><li>{item}</li>)}</ul></div><div><p>{ui.approaches}</p><ul>{caseStudy.tags[locale].map(item=><li>{item}</li>)}</ul></div></div>

    <div class="case-narrative">
      <section class="business-challenge"><div><p class="section-kicker">{ui.challenge}</p><h2>{caseStudy.businessQuestion[locale]}</h2><p>{caseStudy.whyItMatters[locale]}</p></div></section>
      <section><div><h2>{ui.questions}</h2><ul>{businessContent.questions[locale].map(item=><li>{item}</li>)}</ul></div></section>
      <section><div><h2>{ui.evidence}</h2><ul>{caseStudy.evidence[locale].map(item=><li>{item}</li>)}</ul></div></section>
      <section><div><h2>{ui.approach}</h2><ol class="approach-stages">{caseStudy.approach[locale].map(item=><li>{item}</li>)}</ol></div></section>
      <section class="outputs"><div><h2>{ui.outputs}</h2><ul>{businessContent.outputs[locale].map(item=><li>{item}</li>)}</ul></div></section>
      <section><div><h2>{ui.action}</h2><p class="illustrative"><strong>{ui.illustrative}:</strong> {caseStudy.interpretation[locale]}</p><ul>{caseStudy.actions[locale].map(item=><li>{item}</li>)}</ul></div></section>
      <section><div><h2>{ui.measurement}</h2><ul>{caseStudy.measurement[locale].map(item=><li>{item}</li>)}</ul></div></section>
      <section><div><h2>{ui.alternatives}</h2><p>{caseStudy.alternatives[locale]}</p></div></section>
    </div>

    <section class="related" aria-labelledby="related-title"><h2 id="related-title">{ui.related}</h2><div class="related-grid">{related.map(item=><article><p>{item.category[locale]}</p><h3>{item.title[locale]}</h3><a href={caseStudyPath(locale,item.slug)}>{ui.explore}<span aria-hidden="true">↗</span></a></article>)}</div></section>
    <aside class="contact-cta"><h2>{ui.contactTitle}</h2><a class="text-link text-link--accent" href={locale==='en'?'/contact/':'/es/contacto/'}>{ui.contact}</a></aside>
  </article>
</BaseLayout>
<style>
  .back-link{display:inline-flex;min-height:2.75rem;align-items:center;margin-bottom:2rem;font-size:.78rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;text-decoration:none}.case-hero{padding:1rem 0 clamp(4rem,8vw,7rem)}.case-hero-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(20rem,.8fr);gap:clamp(3rem,8vw,8rem);align-items:end}.case-category,.section-kicker{color:var(--color-aubergine);font-size:.72rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.case-hero h1{max-width:12ch;font-size:clamp(3.1rem,6.5vw,6.2rem)}.pdf-resource{margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--color-line)}.pdf-resource p{margin-top:.8rem;color:var(--color-muted);font-size:.85rem}.case-meta-band{display:grid;grid-template-columns:1fr 1fr;gap:3rem;padding:clamp(1.5rem,4vw,3rem);color:var(--color-paper);background:var(--color-aubergine)}.case-meta-band p{font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.case-meta-band ul,.industry-list{display:flex;flex-wrap:wrap;gap:.6rem 1rem;margin:0;padding:0;list-style:none}.case-meta-band li,.industry-list li{padding-bottom:.1rem;border-bottom:.2rem solid var(--color-accent)}
  .case-narrative{margin-top:clamp(4rem,8vw,7rem);border-top:1px solid var(--color-ink)}.case-narrative section{padding-block:clamp(3.5rem,7vw,6rem);border-bottom:1px solid var(--color-line)}.case-narrative section>div{max-width:50rem;margin-inline:auto}.case-narrative h2,.related h2,.contact-cta h2{font-family:var(--font-display);font-size:clamp(2rem,4vw,3.5rem);font-weight:400;letter-spacing:-.04em;line-height:1.08}.business-challenge h2{font-size:clamp(2.4rem,5vw,4.5rem)}.case-narrative li+li{margin-top:.8rem}.approach-stages{margin-top:2rem;padding:0;list-style:none;counter-reset:stage}.approach-stages li{display:grid;grid-template-columns:2.4rem 1fr;gap:1rem;padding-block:1rem;border-top:1px solid var(--color-line);counter-increment:stage}.approach-stages li:before{color:var(--color-aubergine);font-weight:700;content:counter(stage,decimal-leading-zero)}.outputs{background:var(--color-surface);box-shadow:50vw 0 0 var(--color-surface),-50vw 0 0 var(--color-surface)}.illustrative{margin-bottom:2rem;padding-left:1rem;border-left:.3rem solid var(--color-accent);color:var(--color-muted)}.industries-section{border-bottom:0}.industry-list{margin-top:2rem}.related{padding-top:clamp(4rem,8vw,7rem);border-top:1px solid var(--color-ink)}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:2rem;border-top:1px solid var(--color-line)}.related article{display:flex;min-height:16rem;flex-direction:column;padding:1.5rem;border-bottom:1px solid var(--color-line)}.related article+article{border-left:1px solid var(--color-line)}.related article>p{color:var(--color-aubergine);font-size:.7rem;font-weight:700;text-transform:uppercase}.related h3{font-family:var(--font-display);font-size:1.8rem;font-weight:400;line-height:1.1}.related a{display:flex;justify-content:space-between;margin-top:auto;padding-top:1rem;border-top:1px solid var(--color-ink);font-size:.75rem;font-weight:700;text-transform:uppercase;text-decoration:none}.contact-cta{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;margin-top:clamp(5rem,9vw,8rem);padding:clamp(2rem,5vw,4rem);border-top:.5rem solid var(--color-accent);background:var(--color-surface)}.contact-cta h2{max-width:15ch;margin:0}
  .case-meta-band ul{align-items:stretch}.case-meta-band li{display:inline-flex;min-height:2rem;align-items:center;padding:.25rem 0;line-height:1.3}.case-narrative h2+ul,.case-narrative h2+ol,.case-narrative h2+p{margin-top:1.75rem}
  @media(max-width:52rem){.case-hero-grid,.case-meta-band{grid-template-columns:1fr}.related-grid{grid-template-columns:1fr}.related article+article{border-left:0}.contact-cta{align-items:flex-start;flex-direction:column}.case-narrative section>div{margin-inline:0}}@media(max-width:36rem){.case-narrative section{padding-block:3rem}}
</style>
