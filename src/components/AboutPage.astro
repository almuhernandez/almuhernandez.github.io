---
import BaseLayout from '../layouts/BaseLayout.astro';
import type {Locale} from '../content/i18n';
interface Props {locale:Locale}
const {locale}=Astro.props;
const en=locale==='en';
const homeAbout=en?['My background combines Physics and Statistics with over 15 years of experience in Analytics, Data Science and consulting across sectors and international teams.','I connect business questions with data, analysis and practical solutions that help people make decisions.','I also enjoy sharing what I have learned through training, mentoring and workshops.']:['Mi trayectoria combina formación en Física y Estadística con más de 15 años de experiencia en Analytics, Data Science y consultoría en diferentes sectores y entornos internacionales.','He trabajado conectando preguntas de negocio con datos, análisis y soluciones prácticas para ayudar a tomar decisiones.','También disfruto compartiendo lo aprendido a través de la formación, el mentoring y los talleres.'];
const t=en?{
title:'More than data. A way of understanding problems.',eyebrow:'ABOUT ME',intro:'I have spent most of my career between business and analytics.',paragraphs:['For more than 15 years I have worked in analytics and consulting across industries and international teams, helping people understand customers, markets and operations and turn analysis into better decisions.','My background is quantitative, but what interests me most is understanding the problem, structuring it, recognising what data can — and cannot — tell us, and explaining the result clearly.','Teaching Data Analytics has strengthened the way I communicate complex ideas, design practical learning and adapt to different audiences. Today I combine business context, analytics, communication and AI-assisted ways of working.'],
journey:'The journey so far',stages:[['2010–2017','Building a business perspective through analytics','Nielsen · Direct Line Group · GfK','Market research, consumer behaviour, digital analytics and insurance, working with business teams in Madrid, Bristol and London.'],['2017–2023','Analytics in consulting and business','Kernel Analytics · BCG · TheWhiteam / ECDC · Chiper · IAC','Customer Analytics, forecasting, segmentation, customer lifetime value, optimisation and pricing, collaborating with stakeholders and international teams.'],['2024–present','Communication becomes part of analytics','Adalab · Ironhack','Teaching Data Analytics in Spanish and English: 11 completed cohorts and more than 130 learners, strengthening practical communication, feedback and learning design.']],
direction:'Bringing the pieces together',directionText:'Business + analytics · strategy and insights · communication · applied AI. I use AI-assisted workflows in research, analysis, prototyping, documentation and learning. Candidata is an independent early-stage education project.',
education:'Quantitative foundations',degrees:[['MSc Applied Statistics','Birkbeck, University of London','2013–2015'],['Degree in Physics & Atmospheric Science','Universidad Complutense de Madrid','2004–2010']],
expertise:'What I bring to a project',areas:[['Customer & behaviour analytics','Segmentation · RFM · customer lifetime value · market basket analysis'],['Statistical & predictive analytics','Regression · predictive modelling · acquisition modelling · forecasting'],['Operational analytics','Inventory and route optimisation · demand and sales forecasting'],['Business intelligence','SQL · data modelling · visualisation · dashboards · data validation'],['Consulting & communication','Problem framing · data strategy · stakeholder collaboration · training']],
tools:'Tools I work with',toolLines:['Analytics & BI: SQL · Power BI · BigQuery · Tableau · Excel','Programming & statistics: Python · R · SAS · SPSS','Data & workflow: Alteryx · MySQL · Git / GitHub · Hive / Hadoop'],cert:'Professional Scrum Product Owner I (PSPO I) · Scrum.org',cta:'Shall we put data to work?',ctaText:'Explore practical examples or get in touch to talk about a project.',cases:'Explore case studies',contact:'Get in touch'
}:{
title:'Más que datos. Una forma de entender los problemas.',eyebrow:'SOBRE MÍ',intro:'He desarrollado gran parte de mi trayectoria entre el negocio y la analítica.',paragraphs:['Durante más de 15 años he trabajado en analítica y consultoría, en distintos sectores y entornos internacionales, ayudando a entender clientes, mercados y operaciones y a transformar el análisis en mejores decisiones.','Mi formación es cuantitativa, pero lo que más me interesa es entender el problema, estructurarlo, reconocer qué pueden —y qué no pueden— decirnos los datos y comunicar los resultados con claridad.','La docencia en Data Analytics ha reforzado mi manera de explicar ideas complejas, diseñar aprendizaje práctico y adaptarme a distintos públicos. Hoy combino contexto de negocio, analítica, comunicación y nuevas formas de trabajar con IA.'],
journey:'Mi trayectoria',stages:[['2010–2017','Construir una visión de negocio desde los datos','Nielsen · Direct Line Group · GfK','Investigación de mercados, comportamiento del consumidor, analítica digital y seguros, trabajando con equipos de negocio en Madrid, Bristol y Londres.'],['2017–2023','Analítica en consultoría y negocio','Kernel Analytics · BCG · TheWhiteam / ECDC · Chiper · IAC','Customer Analytics, previsión, segmentación, valor de vida del cliente, optimización y pricing, en colaboración con clientes y equipos internacionales.'],['2024–actualidad','La comunicación también forma parte del análisis','Adalab · Ironhack','Docencia en Data Analytics en español e inglés: 11 promociones completadas y más de 130 estudiantes, con especial atención a la comunicación, el feedback y el aprendizaje aplicado.']],
direction:'Unir todas las piezas',directionText:'Negocio + analítica · estrategia e insights · comunicación · IA aplicada. Incorporo herramientas de IA a la investigación, el análisis, los prototipos, la documentación y el aprendizaje. Candidata forma parte de esta etapa como proyecto educativo independiente en fase inicial.',
education:'Mi base cuantitativa',degrees:[['Máster en Estadística Aplicada','Birkbeck, University of London','2013–2015'],['Licenciatura en Física y Ciencias Atmosféricas','Universidad Complutense de Madrid','2004–2010']],
expertise:'Qué aporto a los proyectos',areas:[['Analítica de clientes y comportamiento','Segmentación · RFM · customer lifetime value · análisis de cesta'],['Analítica estadística y predictiva','Regresión · modelos predictivos · adquisición de clientes · forecasting'],['Analítica de operaciones','Optimización de inventario y rutas · previsión de demanda y ventas'],['Business intelligence','SQL · modelado · visualización · dashboards · validación de datos'],['Consultoría y comunicación','Definición de problemas · estrategia de datos · colaboración · formación']],
tools:'Herramientas con las que trabajo',toolLines:['Analítica y BI: SQL · Power BI · BigQuery · Tableau · Excel','Programación y estadística: Python · R · SAS · SPSS','Datos y procesos: Alteryx · MySQL · Git / GitHub · Hive / Hadoop'],cert:'Professional Scrum Product Owner I (PSPO I) · Scrum.org',cta:'¿Ponemos los datos a trabajar?',ctaText:'Explora ejemplos prácticos o escríbeme para hablar de tu proyecto.',cases:'Ver casos de uso',contact:'Escríbeme'
};
---
<BaseLayout title={en?'About me':'Sobre mí'} locale={locale} alternates={[{locale:'en',href:'/about/'},{locale:'es',href:'/es/sobre-mi/'}]}>
<div class="story">
<section class="story-hero"><div class="story-hero-copy"><p class="eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p class="story-lead">{t.intro}</p>{homeAbout.map(p=><p class="story-home-copy">{p}</p>)}</div><figure class="story-photo"><img src="/images/about.jpeg" alt={en?'Almu Hernández smiling with a cup':'Almu Hernández sonriendo con una taza'} loading="eager" /><figcaption>{en?'A little more about my journey':'Un poco más sobre mi trayectoria'}</figcaption></figure></section>

<section class="story-section"><p class="eyebrow">01 / {en?'EXPERIENCE':'EXPERIENCIA'}</p><h2>{t.journey}</h2><div class="story-timeline-showcase"><div class="story-timeline-variant"><p class="timeline-variant-label">{en?'OPTION A · HORIZONTAL':'OPCIÓN A · HORIZONTAL'}</p><div class="story-timeline story-timeline-horizontal">{t.stages.map((st,i)=><article class="story-stage"><span class="story-index">0{i+1}</span><div><p class="story-period">{st[0]}</p><h3>{st[1]}</h3><p class="story-org">{st[2]}</p><p>{st[3]}</p></div></article>)}</div></div><div class="story-timeline-variant"><p class="timeline-variant-label">{en?'OPTION B · VERTICAL':'OPCIÓN B · VERTICAL'}</p><div class="story-timeline story-timeline-vertical">{t.stages.map((st,i)=><article class="story-stage"><span class="story-index">0{i+1}</span><div><p class="story-period">{st[0]}</p><h3>{st[1]}</h3><p class="story-org">{st[2]}</p><p>{st[3]}</p></div></article>)}</div></div></div></section>
<section class="story-direction"><p class="eyebrow">{en?'TODAY':'HOY'}</p><h2>{t.direction}</h2><p>{t.directionText}</p></section>
<section class="story-section"><p class="eyebrow">02 / {en?'EDUCATION':'FORMACIÓN'}</p><h2>{t.education}</h2><div class="story-degrees">{t.degrees.map(d=><article><p class="story-period">{d[2]}</p><h3>{d[0]}</h3><p>{d[1]}</p></article>)}</div></section>
<section class="story-section"><p class="eyebrow">03 / {en?'EXPERTISE':'ESPECIALIDADES'}</p><h2>{t.expertise}</h2><div class="story-areas">{t.areas.map((a,i)=><article><span>0{i+1}</span><div><h3>{a[0]}</h3><p>{a[1]}</p></div></article>)}</div></section>
<section class="story-section story-toolkit"><p class="eyebrow">04 / {en?'TOOLKIT':'HERRAMIENTAS'}</p><h2>{t.tools}</h2>{t.toolLines.map(line=><p>{line}</p>)}<p class="story-cert">{t.cert}</p></section>
<section class="story-cta"><h2>{t.cta}</h2><p>{t.ctaText}</p><div><a href={en?'/consulting/case-studies/':'/es/consultoria/casos-de-uso/'}>{t.cases} ↗</a><a href="mailto:info@almuhernandez.com">{t.contact} ↗</a></div></section>
</div>
</BaseLayout>
<style>
.story{font-family:'DM Sans',sans-serif;color:#171717;background:#f1e8de;padding:0 clamp(24px,7vw,110px) 80px}.story h1,.story h2,.story h3{font-family:'Playfair Display',Georgia,serif;font-weight:400;letter-spacing:-.04em}.story h1{font-style:italic}.story p{line-height:1.65}.eyebrow{font-size:12px;font-weight:700;letter-spacing:.18em;color:#4b123b}.story-hero{display:grid;grid-template-columns:1fr 1fr;gap:clamp(25px,5vw,80px);align-items:center;padding:85px 0 70px}.story h1{font-size:clamp(49px,5.8vw,94px);line-height:1.1;margin:25px 0}.story-lead{font-size:clamp(19px,2vw,27px);max-width:27ch;font-family:'Playfair Display',Georgia,serif}.story-home-copy{font-size:16px;line-height:1.65;margin:13px 0;max-width:58ch}.story-photo{margin:0;min-width:0}.story-photo img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center;display:block}.story-photo figcaption{font-size:12px;margin-top:12px;color:#6e5d67}.story-intro{max-width:850px;padding:20px 0 95px;margin:auto}.story-intro p{font-size:clamp(18px,2vw,24px);line-height:1.65}.story-intro p:first-child{font-family:'Playfair Display',Georgia,serif;font-size:clamp(25px,3vw,38px)}.story-section{padding:80px 0;border-top:1px solid #b9a9af}.story-section h2,.story-direction h2{font-size:clamp(40px,5vw,70px);margin:12px 0 45px}.story-timeline{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.story-stage{border-top:4px solid #4b123b;padding:26px 10px 15px 0;display:grid;grid-template-columns:35px 1fr;gap:10px}.story-index{color:#ad8c26;font-size:24px;font-family:Georgia,serif}.story-stage h3{font-size:clamp(23px,2.4vw,34px);line-height:1.25}.story-period{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#4b123b}.story-org{font-size:13px;font-weight:700}.story-direction{background:#4b123b;color:#f1e8de;padding:clamp(40px,6vw,85px);margin:10px 0 65px}.story-direction .eyebrow{color:#e9c75f}.story-direction p:last-child{font-size:19px;max-width:820px}.story-degrees{display:grid;grid-template-columns:1fr 1fr;gap:24px}.story-degrees article{background:#e9c75f;padding:35px}.story-degrees article:nth-child(2){background:#dfcbd9}.story-degrees h3{font-size:30px}.story-areas{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.story-areas article{display:flex;flex-direction:column;gap:14px;border-top:0;padding:28px;min-height:220px;background:#e9c75f;color:#171717}.story-areas article:nth-child(5n+2){background:#4b123b;color:#fff}.story-areas article:nth-child(5n+3){background:#dfcbd9}.story-areas article:nth-child(5n+4){background:#171717;color:#fff}.story-areas article:nth-child(5n+5){background:#e5d5c5}.story-areas article span{color:inherit;opacity:.75;font-size:22px}.story-areas h3{font-size:26px;margin:0 0 8px}.story-areas p{margin:0}.story-toolkit>p:not(.eyebrow){border-top:1px solid #c6b5bc;padding:15px 0;margin:0}.story-toolkit .story-cert{font-size:13px;color:#4b123b}.story-cta{background:#4b123b;color:#fff;padding:clamp(40px,6vw,85px)}.story-cta h2{font-size:clamp(40px,5vw,70px);margin:0}.story-cta p{font-size:19px}.story-cta div{display:flex;flex-wrap:wrap;gap:18px;margin-top:30px}.story-cta a{color:#171717;background:#e9c75f;text-decoration:none;padding:16px 22px;font-weight:700;font-size:12px;letter-spacing:.06em;text-transform:uppercase}.story-cta a+ a{color:#fff;background:transparent;border:1px solid #fff}@media(max-width:850px){.story-hero{grid-template-columns:1fr;padding-top:45px}.story-photo{max-width:620px}.story-timeline{grid-template-columns:1fr}.story-areas{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.story-areas{grid-template-columns:1fr}}@media(max-width:550px){.story-degrees{grid-template-columns:1fr}.story{padding-inline:22px}.story-hero h1{font-size:clamp(43px,12vw,64px)}}

/* Two editorial timeline directions to compare in the same page. */
.story-timeline-showcase{display:grid;gap:35px}
.story-timeline-variant{background:#4b123b;color:#f1e8de;padding:clamp(25px,4vw,55px);overflow:hidden}
.story-timeline-variant:nth-child(2){background:#171717}
.timeline-variant-label{color:#e9c75f;font-size:12px;font-weight:700;letter-spacing:.15em;margin:0 0 28px}
.story-timeline-horizontal{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.story-timeline-horizontal:before{content:"";position:absolute;top:15px;left:0;right:0;height:3px;background:#e9c75f}
.story-timeline .story-stage{border:0;padding:0;display:block;position:relative}
.story-timeline-horizontal .story-stage{padding-top:48px}
.story-timeline-horizontal .story-stage:before{content:"";position:absolute;top:5px;left:8px;width:20px;height:20px;border:4px solid #e9c75f;background:#4b123b;border-radius:50%;box-sizing:border-box;z-index:1}
.story-timeline .story-index{display:inline-block;font-size:32px;color:#e9c75f;margin-bottom:12px}
.story-timeline .story-period{color:#e9c75f}
.story-timeline .story-stage h3{font-size:clamp(22px,2.1vw,30px);line-height:1.25}
.story-timeline .story-stage p{color:inherit}
.story-timeline .story-org{font-weight:700;opacity:.9}
.story-timeline-vertical{display:flex;flex-direction:column;gap:0;position:relative;margin-left:13px;padding-left:42px}
.story-timeline-vertical:before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:3px;background:#e9c75f}
.story-timeline-vertical .story-stage{padding:0 0 35px;max-width:750px}
.story-timeline-vertical .story-stage:before{content:"";position:absolute;left:-51px;top:7px;width:20px;height:20px;border:4px solid #e9c75f;border-radius:50%;background:#171717;box-sizing:border-box}
.story-timeline-vertical .story-stage:nth-child(even){margin-left:clamp(0px,7vw,90px)}
.story-areas{grid-template-columns:repeat(5,minmax(210px,1fr));gap:12px;overflow-x:auto;padding-bottom:15px}
.story-areas article{min-width:0;padding:24px}
.story-areas h3{font-size:clamp(20px,1.7vw,26px)}
@media(max-width:850px){.story-timeline-horizontal{grid-template-columns:repeat(3,minmax(220px,1fr));overflow-x:auto;padding-bottom:15px}.story-timeline-horizontal:before{right:auto;width:750px}.story-areas{grid-template-columns:repeat(5,minmax(220px,1fr))}}
</style>